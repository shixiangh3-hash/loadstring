local function toggleLowHp()
    if lowHpEnabled then
        lowHpEnabled = false
        if lowHpConnection then lowHpConnection:Disconnect(); lowHpConnection = nil end
        if lowHpGui then lowHpGui:Destroy(); lowHpGui = nil end
        lowHpFrame = nil
        lowHpButton.Text = "低血量警示"
        showToast("低血量警示已關閉")
    else
        lowHpEnabled = true
        lowHpGui = Instance.new("ScreenGui")
        lowHpGui.Name = PREFIX .. "LowHp"
        lowHpGui.ResetOnSpawn = false
        lowHpGui.IgnoreGuiInset = true
        lowHpGui.DisplayOrder = 999996
        lowHpGui.Parent = PlayerGui

        lowHpFrame = Instance.new("Frame")
        lowHpFrame.Size = UDim2.fromScale(1, 1)
        lowHpFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        lowHpFrame.BackgroundTransparency = 1
        lowHpFrame.BorderSizePixel = 0
        lowHpFrame.ZIndex = 999996
        lowHpFrame.Parent = lowHpGui
        local grad = Instance.new("UIGradient")
        grad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.2),
            NumberSequenceKeypoint.new(0.5, 1),
            NumberSequenceKeypoint.new(1, 0.2)
        })
        grad.Rotation = 90
        grad.Parent = lowHpFrame

        lowHpConnection = RunService.RenderStepped:Connect(function()
            local char = Player.Character
            if not char then return end
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not humanoid then return end
            local ratio = humanoid.Health / humanoid.MaxHealth
            if ratio <= 0.3 and lowHpFrame then
                local intensity = 0.75 - (0.3 - ratio) * 2.75
                intensity = math.clamp(intensity, 0.2, 0.75)
                lowHpFrame.BackgroundTransparency = intensity
            else
                if lowHpFrame then lowHpFrame.BackgroundTransparency = 1 end
            end
        end)

        lowHpButton.Text = "低血量警示：已開啟"
        showToast("低血量警示已開啟")
    end
end
lowHpButton.Activated:Connect(toggleLowHp)

