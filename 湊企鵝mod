end

local function applySunset()
    clearOwned(); baseLighting()
    Lighting.ClockTime = 17.65; Lighting.Brightness = 2.05
    Lighting.ExposureCompensation = 0.08; Lighting.Ambient = Color3.fromRGB(22, 25, 40)
    Lighting.OutdoorAmbient = Color3.fromRGB(74, 82, 116)
    Lighting.ColorShift_Top = Color3.fromRGB(255, 198, 132)
    Lighting.ColorShift_Bottom = Color3.fromRGB(70, 86, 155)
    Lighting.FogColor = Color3.fromRGB(250, 181, 120); Lighting.FogStart = 350; Lighting.FogEnd = 100000
