local function updateRain(input)
    local width = math.max(rainTrack.AbsoluteSize.X, 1)
    local x = input.Position.X - rainTrack.AbsolutePosition.X

    rainAmount = math.clamp(x / width, 0.05, 1)

    rainKnob.Position = UDim2.new(
        rainAmount,
        -12,
        0.5,
        -12
    )

    if rainAmount < 0.34 then
        rainLabel.Text = "雨量：小"
    elseif rainAmount < 0.67 then
        rainLabel.Text = "雨量：中"
    else
        rainLabel.Text = "雨量：大"
    end

    if rainEnabled then
        resizeRain()
    end
end

rainTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        rainDragging = true
        updateRain(input)
    end
end)

rainKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

