local rgbObjects = {}
local function addRGB(obj, prop) table.insert(rgbObjects, {object = obj, property = prop}) end
local function rgbColor(speed, offset) return Color3.fromHSV(((os.clock() * speed) + (offset or 0)) % 1, 0.58, 0.93) end
RunService.RenderStepped:Connect(function()
    for i, data in ipairs(rgbObjects) do
        if data.object and data.object.Parent then
            pcall(function() data.object[data.property] = rgbColor(0.08, i * 0.025) end)
        end
    end
end)
local function addRGBStroke(obj, thickness)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1.5
    s.Transparency = 0.08
    s.Parent = obj
    addRGB(s, "Color")
    return s
end

