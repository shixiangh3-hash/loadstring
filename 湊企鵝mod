local function stopRain()
    if rainConnection then
        rainConnection:Disconnect()
        rainConnection = nil
    end

    if rainFolder then
        rainFolder:Destroy()
        rainFolder = nil
    end

    table.clear(rainDrops)
    rainEnabled = false
end

local function rainCount()
    return math.floor(100 + rainAmount * 900)
end

local function resizeRain()
    if not rainFolder then
        return
    end

    local folder = rainFolder:FindFirstChild("Drops")
    if not folder then
        return
    end

    while #rainDrops < rainCount() do
        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Material = Enum.Material.Neon
        part.Color = Color3.fromRGB(165, 198, 230)
        part.Transparency = 0.18
        part.Size = Vector3.new(0.08, math.random(34, 58) / 10, 0.08)
        part.Parent = folder

        table.insert(rainDrops, {
            part = part,
            offset = Vector3.new(
                math.random(-70, 70),
                math.random(-10, 70),
                math.random(-70, 70)
            ),
            speed = math.random(78, 122)
        })
    end

    while #rainDrops > rainCount() do
        local drop = table.remove(rainDrops)
        if drop and drop.part then
            drop.part:Destroy()
        end
    end
end

local function startRain()
    stopRain()
    rainEnabled = true

    rainFolder = Instance.new("Folder")
    rainFolder.Name = PREFIX .. "Rain"
    rainFolder.Parent = workspace

    local folder = Instance.new("Folder")
    folder.Name = "Drops"
    folder.Parent = rainFolder

    resizeRain()

    rainConnection = RunService.RenderStepped:Connect(function(dt)
        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        for _, drop in ipairs(rainDrops) do
            if drop.part and drop.part.Parent then
                drop.offset -= Vector3.new(
                    3.5,
                    drop.speed,
                    2.2
                ) * dt

                if drop.offset.Y < -12 then
                    drop.offset = Vector3.new(
                        math.random(-70, 70),
                        math.random(46, 75),
                        math.random(-70, 70)
                    )
                end

                drop.part.Position =
                    camera.CFrame.Position + drop.offset
            end
        end
    end)

    weatherButton.Text = "當前天氣：下雨"
    showToast("下雨以載入", "小翔製作")
end

--==================================================
-- 日夜循環
--==================================================

local function startCycle()
    cycleToken += 1
    local token = cycleToken

    cycling = true
    lightEnabled = true
    toggleButton.Text = "關閉光影"

    showToast("日夜循環以載入", "小翔製作")

    task.spawn(function()
        while cycling and token == cycleToken do
            applyDay()
            statusLabel.Text = "目前狀態：日夜循環｜白天"
            task.wait(180)

            if not cycling or token ~= cycleToken then
                break
            end

            applySunset()
            statusLabel.Text = "目前狀態：日夜循環｜夕陽"
            task.wait(30)

            if not cycling or token ~= cycleToken then
                break
            end

            applyNight()
            statusLabel.Text = "目前狀態：日夜循環｜夜晚"
            task.wait(60)
        end
    end)
end

