local function removeRotatingCrosshair()
    rotatingCrosshairEnabled = false

    if rotatingCrosshairConnection then
        rotatingCrosshairConnection:Disconnect()
        rotatingCrosshairConnection = nil
    end

    if rotatingCrosshairGui then
        rotatingCrosshairGui:Destroy()
        rotatingCrosshairGui = nil
    end

    rotatingCrosshairHolder = nil
    table.clear(rotatingCrosshairLines)
end

local function createRotatingLine(parent, size, position)
    local line = Instance.new("Frame")
    line.Size = size
    line.Position = position
    line.AnchorPoint = Vector2.new(0.5, 0.5)
    line.BackgroundColor3 = Color3.fromRGB(80, 255, 100)
    line.BorderSizePixel = 0
    line.ZIndex = 5000
    line.Parent = parent
    addCorner(line, 2)

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(10, 10, 10)
    stroke.Parent = line

    table.insert(rotatingCrosshairLines, line)
end

local function createRotatingCrosshair()
    removeTechCrosshair()
    removeRotatingCrosshair()

    rotatingCrosshairEnabled = true
    rotatingCrosshairRotation = 0

    rotatingCrosshairGui = Instance.new("ScreenGui")
    rotatingCrosshairGui.Name = "PenguinModCrosshair"
    rotatingCrosshairGui.ResetOnSpawn = false
    rotatingCrosshairGui.IgnoreGuiInset = true
    rotatingCrosshairGui.DisplayOrder = 1000000
    rotatingCrosshairGui.Parent = PlayerGui

    rotatingCrosshairHolder = Instance.new("Frame")
    rotatingCrosshairHolder.Size = UDim2.fromOffset(90, 90)
    rotatingCrosshairHolder.Position = UDim2.fromScale(0.5, 0.5)
