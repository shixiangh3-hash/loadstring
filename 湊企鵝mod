-- 音效函式（先定義，後面才能呼叫）
--====================================================
local function playSound(id, vol, looped, speed)
    local s = nil
    pcall(function()
        s = Instance.new("Sound")
        s.SoundId = id
        s.Volume = vol or 1
        s.Looped = looped or false
        s.PlaybackSpeed = speed or 1
        s.Parent = SoundService
        s:Play()
    end)
    if s and not looped then
        task.delay(10, function()
            pcall(function() s:Destroy() end)
        end)
    end
    return s
end

local function playClick() playSound(CLICK_SOUND, 2.0, false, 0.85) end
local function playStartup() playSound(STARTUP_SOUND, 3, false) end

local rainSoundObj = nil
local function startRainSound()
    if rainSoundObj then return end
    rainSoundObj = playSound(RAIN_SOUND, 2, true)
end
local function stopRainSound()
    if rainSoundObj then
        pcall(function() rainSoundObj:Stop(); rainSoundObj:Destroy() end)
        rainSoundObj = nil
    end
end

