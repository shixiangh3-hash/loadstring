-- 還原
--==================================================

local function restore()
    cycleToken += 1
    cycling = false

    stopRain()
    removeRotatingCrosshair()
    removeTechCrosshair()
    clearOwned()

    if fpsGrayEffect then
        fpsGrayEffect:Destroy()
        fpsGrayEffect = nil
    end

    if fpsGrayAtmosphere then
        fpsGrayAtmosphere:Destroy()
        fpsGrayAtmosphere = nil
    end

    for property, value in pairs(savedLighting) do
        if tostring(property):sub(1, 6) ~= "__FPS_" then
            safeSet(Lighting, property, value)
        end
    end

    if savedLighting.__FPS_Ambient then
        Lighting.Ambient = savedLighting.__FPS_Ambient
        Lighting.OutdoorAmbient = savedLighting.__FPS_OutdoorAmbient
        Lighting.ColorShift_Top = savedLighting.__FPS_Top
        Lighting.ColorShift_Bottom = savedLighting.__FPS_Bottom
        Lighting.FogColor = savedLighting.__FPS_Fog
        Lighting.FogStart = savedLighting.__FPS_FogStart
        Lighting.FogEnd = savedLighting.__FPS_FogEnd
    end

    for property, value in pairs(savedTerrain) do
        if Terrain then
            safeSet(Terrain, property, value)
        end
    end

    for _, data in ipairs(savedParts) do
        if data.part and data.part.Parent then
            safeSet(data.part, "Material", data.material)
            safeSet(data.part, "Color", data.color)
            safeSet(data.part, "Reflectance", data.reflectance)
            safeSet(data.part, "CastShadow", data.castShadow)
            safeSet(data.part, "Transparency", data.transparency)
        end
    end

    for _, data in ipairs(savedVisuals) do
        if data.object and data.object.Parent then
            if data.transparency ~= nil then
                safeSet(data.object, "Transparency", data.transparency)
            end

            if data.enabled ~= nil then
                safeSet(data.object, "Enabled", data.enabled)
            end
        end
    end

    for _, sky in ipairs(savedSky) do
        if sky then
            sky:Clone().Parent = Lighting
        end
    end

    for _, effect in ipairs(savedEffects) do
        if effect then
            effect:Clone().Parent = Lighting
        end
    end

    table.clear(savedParts)
    table.clear(savedVisuals)
    table.clear(savedSky)

    fpsEnabled = false
    minecraftEnabled = false
    lightEnabled = false

    if fpsButton then
        fpsButton.Text = "增加 FPS"
    end

    if minecraftButton then
        minecraftButton.Text = "麥塊紋理包"
    end

    if rotatingButton then
        rotatingButton.Text = "開啟旋轉準心"
    end

    if techButton then
        techButton.Text = "開啟科技準心"
    end
end

