local musicSound = nil
local musicVolume = 1.0
local musicSaves = {}
local function saveMusicData()
    pcall(function()
        if writefile then writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode(musicSaves)) end
    end)
end
local function loadMusicData()
    local s, data = pcall(function()
        if readfile and isfile and isfile(SAVE_FILE) then
            return game:GetService("HttpService"):JSONDecode(readfile(SAVE_FILE))
        end
        return nil
    end)
    if s and data and type(data) == "table" then musicSaves = data; return true end
    return false
end
local function playMusicById(id)
    if not id or id == "" then showToast("請輸入音樂 ID"); return end
    if musicSound then musicSound:Destroy(); musicSound = nil end
    local s = pcall(function()
        musicSound = Instance.new("Sound")
        musicSound.Name = PREFIX .. "Music"
        musicSound.SoundId = "rbxassetid://" .. id
        musicSound.Looped = true
        musicSound.Volume = musicVolume
        musicSound.Parent = SoundService
        musicSound:Play()
    end)
    if s then showToast("音樂播放中") else showToast("音樂播放失敗") end
end
local function stopMusic()
    if musicSound then
        pcall(function() musicSound:Stop(); musicSound:Destroy() end)
        musicSound = nil
    end
    showToast("音樂已停止")
end
local function deleteSave(index)
    if musicSaves[index] then
        local name = musicSaves[index].name
        table.remove(musicSaves, index)
        saveMusicData()
        refreshMusicSaveList()
        showToast("已刪除存檔：" .. name)
    end
end
function refreshMusicSaveList()
    for _, child in ipairs(musicSaveListFrame:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then child:Destroy() end
    end
    local y = 0
    for i, save in ipairs(musicSaves) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -90, 0, 34)
        btn.Position = UDim2.fromOffset(15, y)
        btn.BackgroundColor3 = Color3.fromRGB(60, 80, 110)
        btn.Text = save.name .. " (ID: " .. save.id .. ")"
        btn.TextColor3 = Color3.fromRGB(240, 240, 240)
        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold
        btn.ZIndex = 1100
        btn.Parent = musicSaveListFrame
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = btn
        btn.Activated:Connect(function() playClick(); playMusicById(save.id) end)
        local delBtn = Instance.new("TextButton")
        delBtn.Size = UDim2.fromOffset(60, 34)
        delBtn.Position = UDim2.fromOffset(15 + (musicSaveListFrame.AbsoluteSize.X - 90) + 5, y)
        delBtn.BackgroundColor3 = Color3.fromRGB(150, 60, 60)
        delBtn.Text = "刪除"
        delBtn.TextColor3 = Color3.fromRGB(255, 220, 220)
        delBtn.TextSize = 12
        delBtn.Font = Enum.Font.GothamBold
        delBtn.ZIndex = 1100
        delBtn.Parent = musicSaveListFrame
        local dc = Instance.new("UICorner"); dc.CornerRadius = UDim.new(0, 8); dc.Parent = delBtn
        delBtn.Activated:Connect(function() playClick(); deleteSave(i) end)
        y = y + 40
    end
    if #musicSaves == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -30, 0, 30)
        empty.Position = UDim2.fromOffset(15, 0)
        empty.BackgroundTransparency = 1
        empty.Text = "（目前沒有存檔）"
        empty.TextColor3 = Color3.fromRGB(160, 170, 190)
        empty.TextSize = 13
        empty.Font = Enum.Font.Gotham
        empty.ZIndex = 1100
        empty.Parent = musicSaveListFrame
    end
end
