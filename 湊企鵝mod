local function applyFog()
    clearOwned(); baseLighting()
    Lighting.ClockTime = 17.85; Lighting.Brightness = 1.9
    Lighting.ExposureCompensation = 0.06; Lighting.Ambient = Color3.fromRGB(24, 28, 44)
    Lighting.OutdoorAmbient = Color3.fromRGB(76, 84, 118)
    Lighting.FogColor = Color3.fromRGB(205, 170, 145); Lighting.FogStart = 0; Lighting.FogEnd = 260
    effects(Color3.fromRGB(220, 205, 198), 0.5, 2.45, Color3.fromRGB(250, 225, 208), 0.01, 0.25, 0.02)
end

local function selectMode(mode, name)
    cycleToken += 1; cycle = false; lightEnabled = true
    if mode == "預設光影" then applyPreset()
    elseif mode == "白天" then applyDay()
    elseif mode == "夜間" then applyNight()
    elseif mode == "起霧" then applyFog()
    else applySunset() end
    statusLabel.Text = "目前狀態：" .. name; timeButton.Text = "當前時間：" .. name
    toggleButton.Text = "關閉光影"; main.Visible = true
    timeMenu.Visible = false; weatherMenu.Visible = false
    settingMenu.Visible = false; crosshairMenu.Visible = false
    showToast(name .. "以載入", "小翔製作")
end

