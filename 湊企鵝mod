local function toggleFPSCounter()
    if fpsCounterEnabled then
        fpsCounterEnabled = false
        if fpsConnection then fpsConnection:Disconnect(); fpsConnection = nil end
        if fpsGui then fpsGui:Destroy(); fpsGui = nil end
        fpsLabel = nil
        if fpsCounterButton then fpsCounterButton.Text = "FPS 顯示器" end
        showToast("FPS顯示器已關閉", "小翔製作")
    else
        fpsCounterEnabled = true
        fpsFrameCount = 0
        fpsTimeElapsed = 0
        fpsCurrent = 0

        fpsGui = Instance.new("ScreenGui")
        fpsGui.Name = PREFIX .. "FpsDisplay"
        fpsGui.ResetOnSpawn = false
        fpsGui.IgnoreGuiInset = true
        fpsGui.DisplayOrder = 999998
        fpsGui.Parent = PlayerGui

        fpsLabel = Instance.new("TextLabel")
        fpsLabel.Size = UDim2.fromOffset(120, 32)
        fpsLabel.Position = UDim2.new(1, -130, 0, 12)
        fpsLabel.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
        fpsLabel.BackgroundTransparency = 0.35
        fpsLabel.Text = "FPS: --"
        fpsLabel.TextColor3 = Color3.fromRGB(120, 255, 140)
        fpsLabel.TextSize = 16
        fpsLabel.Font = Enum.Font.GothamBold
        fpsLabel.ZIndex = 999999
        fpsLabel.Parent = fpsGui
        addCorner(fpsLabel, 8)

        fpsConnection = RunService.RenderStepped:Connect(function(dt)
            fpsFrameCount += 1
            fpsTimeElapsed += dt
            if fpsTimeElapsed >= 0.5 then
                fpsCurrent = math.floor(fpsFrameCount / fpsTimeElapsed + 0.5)
                fpsFrameCount = 0
                fpsTimeElapsed = 0

                if fpsLabel then
                    fpsLabel.Text = "FPS: " .. fpsCurrent
                    if fpsCurrent >= 50 then
                        fpsLabel.TextColor3 = Color3.fromRGB(120, 255, 140)
                    elseif fpsCurrent >= 30 then
                        fpsLabel.TextColor3 = Color3.fromRGB(255, 220, 100)
                    else
                        fpsLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                    end
                end
            end
        end)

        if fpsCounterButton then fpsCounterButton.Text = "FPS 顯示器：已開啟" end
        showToast("FPS顯示器已開啟", "小翔製作")
    end
end

