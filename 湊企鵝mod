local function enableFPS()
    if fpsEnabled then showToast("增加FPS已載入", "小翔製作"); return end
    fpsEnabled = true; table.clear(savedParts); table.clear(savedVisuals)

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(gui) and not obj.Name:find(PREFIX) then
            table.insert(savedParts, {part = obj, material = obj.Material, color = obj.Color, reflectance = obj.Reflectance, castShadow = obj.CastShadow, transparency = obj.Transparency})
            obj.Material = Enum.Material.SmoothPlastic; obj.Reflectance = 0; obj.CastShadow = false
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SurfaceAppearance") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            local data = {object = obj, enabled = nil, transparency = nil}
            if obj:IsA("Decal") or obj:IsA("Texture") then data.transparency = obj.Transparency; obj.Transparency = 1
            elseif obj:IsA("SurfaceAppearance") then data.enabled = obj.Enabled; obj.Enabled = false
            else data.enabled = obj.Enabled; obj.Enabled = false end
            table.insert(savedVisuals, data)
        end
    end
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Sky") then table.insert(savedSky, obj:Clone()); obj:Destroy() end
    end

    fpsGrayEffect = Instance.new("ColorCorrectionEffect")
    fpsGrayEffect.Name = PREFIX .. "FPSGray"; fpsGrayEffect.Brightness = -0.03
    fpsGrayEffect.Contrast = -0.02; fpsGrayEffect.Saturation = -1
    fpsGrayEffect.TintColor = Color3.fromRGB(185, 185, 185); fpsGrayEffect.Parent = Lighting

    fpsGrayAtmosphere = Instance.new("Atmosphere")
    fpsGrayAtmosphere.Name = PREFIX .. "FPSAtmosphere"; fpsGrayAtmosphere.Color = Color3.fromRGB(155, 155, 155)
    fpsGrayAtmosphere.Decay = Color3.fromRGB(155, 155, 155); fpsGrayAtmosphere.Density = 1
    fpsGrayAtmosphere.Haze = 10; fpsGrayAtmosphere.Glare = 0; fpsGrayAtmosphere.Parent = Lighting

    savedLighting.__FPS_Ambient = Lighting.Ambient; savedLighting.__FPS_OutdoorAmbient = Lighting.OutdoorAmbient
    savedLighting.__FPS_Top = Lighting.ColorShift_Top; savedLighting.__FPS_Bottom = Lighting.ColorShift_Bottom
    savedLighting.__FPS_Fog = Lighting.FogColor; savedLighting.__FPS_FogStart = Lighting.FogStart; savedLighting.__FPS_FogEnd = Lighting.FogEnd

    Lighting.Ambient = Color3.fromRGB(135, 135, 135); Lighting.OutdoorAmbient = Color3.fromRGB(145, 145, 145)
    Lighting.ColorShift_Top = Color3.fromRGB(145, 145, 145); Lighting.ColorShift_Bottom = Color3.fromRGB(135, 135, 135)
    Lighting.FogColor = Color3.fromRGB(155, 155, 155); Lighting.FogStart = 0; Lighting.FogEnd = 100000
    showToast("增加FPS已載入", "小翔製作")
end

