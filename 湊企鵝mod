        local delta = input.Position - dragStart
        if delta.Magnitude > 8 then orbMoved = true end
        orb.Position = UDim2.new(orbStart.X.Scale, orbStart.X.Offset + delta.X, orbStart.Y.Scale, orbStart.Y.Offset + delta.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        rainDragging = false; snowDragging = false; crosshairScaleDragging = false; musicVolumeDragging = false; orbDragging = false
    end
end)

--==================================================
-- 快捷鍵：按 I 開關主介面
--==================================================
UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.I then
        main.Visible = not main.Visible
        if main.Visible then
            timeMenu.Visible = false; weatherMenu.Visible = false
            settingMenu.Visible = false; crosshairMenu.Visible = false; musicMenu.Visible = false
        end
    end
end)

--==================================================
-- 清理
--==================================================
script.Destroying:Connect(function()
    restore()
    stopMusic()
    if gui then gui:Destroy() end
end)

