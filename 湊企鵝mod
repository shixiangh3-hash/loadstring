    local blackDiamondButton = createBtn(crosshairScroll, 158, "開啟黑色菱形準星", Color3.fromRGB(30, 30, 30), 40)
    local scaleLabel = Instance.new("TextLabel")
    scaleLabel.Size = UDim2.new(1, -30, 0, 24)
    scaleLabel.Position = UDim2.fromOffset(15, 212)
    scaleLabel.BackgroundTransparency = 1
    scaleLabel.Text = "準心大小：1.0x"
    scaleLabel.TextColor3 = Color3.fromRGB(220, 230, 245)
    scaleLabel.TextSize = 15
    scaleLabel.Font = Enum.Font.GothamBold
    scaleLabel.ZIndex = 1100
    scaleLabel.Parent = crosshairScroll
    local scaleTrack = Instance.new("Frame")
    scaleTrack.Size = UDim2.new(1, -40, 0, 8)
    scaleTrack.Position = UDim2.fromOffset(20, 245)
    scaleTrack.BackgroundColor3 = Color3.fromRGB(80, 90, 110)
    scaleTrack.ZIndex = 1100
    scaleTrack.Parent = crosshairScroll
    local sctc = Instance.new("UICorner"); sctc.CornerRadius = UDim.new(0, 5); sctc.Parent = scaleTrack
    local scaleKnob = Instance.new("TextButton")
    scaleKnob.Size = UDim2.fromOffset(24, 24)
    scaleKnob.Position = UDim2.new(0.5, -12, 0.5, -12)
    scaleKnob.BackgroundColor3 = Color3.fromRGB(180, 220, 255)
    scaleKnob.Text = ""
    scaleKnob.ZIndex = 1200
    scaleKnob.Parent = scaleTrack
    local skc2 = Instance.new("UICorner"); skc2.CornerRadius = UDim.new(0, 20); skc2.Parent = scaleKnob
    local crosshairDone = createBtn(crosshairScroll, 285, "完成", Color3.fromRGB(92, 65, 76), 38)
    crosshairPageButton.Activated:Connect(function() closeAllMenus(); crosshairMenu.Visible = true end)
    crosshairDone.Activated:Connect(function() closeAllMenus(); main.Visible = true end)

    rotationButton.Activated:Connect(function()
        if rotationCrosshairEnabled then
            removeRotatingCrosshair(); rotationButton.Text = "開啟旋轉準心"
        else
            removeTechCrosshair(); removeBlackDiamondCrosshair()
            techButton.Text = "開啟科技準心"; blackDiamondButton.Text = "開啟黑色菱形準星"
            createRotatingCrosshairFn(); rotationButton.Text = "關閉旋轉準心"
        end
    end)
    techButton.Activated:Connect(function()
        if techCrosshairEnabled then
            removeTechCrosshair(); techButton.Text = "開啟科技準心"
        else
            removeRotatingCrosshair(); removeBlackDiamondCrosshair()
            rotationButton.Text = "開啟旋轉準心"; blackDiamondButton.Text = "開啟黑色菱形準星"
            createTechCrosshairFn(); techButton.Text = "關閉科技準心"
        end
    end)
    blackDiamondButton.Activated:Connect(function()
        if blackDiamondEnabled then
            removeBlackDiamondCrosshair(); blackDiamondButton.Text = "開啟黑色菱形準星"
        else
            removeRotatingCrosshair(); removeTechCrosshair()
            rotationButton.Text = "開啟旋轉準心"; techButton.Text = "開啟科技準心"
            createBlackDiamondCrosshairFn(); blackDiamondButton.Text = "關閉黑色菱形準星"
        end
    end)

    local scaleDragging = false
    local function updateScaleSlider(input)
        local width = math.max(scaleTrack.AbsoluteSize.X, 1)
        local x = input.Position.X - scaleTrack.AbsolutePosition.X
        local ratio = math.clamp(x / width, 0, 1)
        crosshairScale = 0.3 + ratio * 2.7
        scaleKnob.Position = UDim2.new(ratio, -12, 0.5, -12)
        scaleLabel.Text = string.format("準心大小：%.1fx", crosshairScale)
        if rotationCrosshairEnabled then createRotatingCrosshairFn() end
        if techCrosshairEnabled then createTechCrosshairFn() end
        if blackDiamondEnabled then createBlackDiamondCrosshairFn() end
    end
    scaleTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            scaleDragging = true; updateScaleSlider(input)
        end
    end)
    scaleKnob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then scaleDragging = true end
    end)
    UIS.InputChanged:Connect(function(input)
        if scaleDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateScaleSlider(input) end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then scaleDragging = false end
    end)
end

