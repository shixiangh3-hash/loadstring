local function applyCulling()
    isCullingEnabled = not isCullingEnabled
    if isCullingEnabled then
        cullingBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50); cullingBtn.Text = "👁️ 已開啟剔除"
        local tickRate = 0
        cullingConn = RunService.Heartbeat:Connect(function(dt)
            tickRate = tickRate + dt
            if tickRate < 0.5 then return end
            tickRate = 0
            local cam = Workspace.CurrentCamera; if not cam then return end
            for _, obj in ipairs(Workspace:GetChildren()) do
                if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                    if (obj.Position - cam.CFrame.Position).Magnitude > 500 then
                        if obj.LocalTransparencyModifier ~= 1 then obj.LocalTransparencyModifier = 1; hiddenParts[obj] = true end
                    else
                        if hiddenParts[obj] then obj.LocalTransparencyModifier = 0; hiddenParts[obj] = nil end
                    end
                end
            end
        end)
    else
        cullingBtn.BackgroundColor3 = Color3.fromRGB(50, 100, 130); cullingBtn.Text = "👁️ 遠處剔除 (隱藏500格)"
        if cullingConn then cullingConn:Disconnect(); cullingConn = nil end
        for obj, _ in pairs(hiddenParts) do pcall(function() obj.LocalTransparencyModifier = 0 end) end
        table.clear(hiddenParts)
    end
end

