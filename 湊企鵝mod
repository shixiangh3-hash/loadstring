--==================================================
-- 雨量滑桿
--==================================================
local function updateRain(input)
    local width = math.max(rainTrack.AbsoluteSize.X, 1)
    local x = input.Position.X - rainTrack.AbsolutePosition.X
    rainAmount = math.clamp(x / width, 0.05, 1)
    rainKnob.Position = UDim2.new(rainAmount, -12, 0.5, -12)
    if rainAmount < 0.34 then rainLabel.Text = "雨量：小"
    elseif rainAmount < 0.67 then rainLabel.Text = "雨量：中"
    else rainLabel.Text = "雨量：大" end
    if rainEnabled then resizeRain() end
end

rainTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        rainDragging = true; updateRain(input)
    end
end)

rainKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        rainDragging = true
    end
end)

--==================================================
-- 懸浮球拖曳與點擊
--==================================================
orb.Activated:Connect(function()
    if orbMoved then orbMoved = false; return end
    main.Visible = not main.Visible
    if main.Visible then
        timeMenu.Visible = false; weatherMenu.Visible = false
        settingMenu.Visible = false; crosshairMenu.Visible = false
    end
end)

orb.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        orbDragging = true; orbMoved = false; dragStart = input.Position; orbStart = orb.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if rainDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateRain(input) end
    if orbDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if delta.Magnitude > 8 then orbMoved = true end
        orb.Position = UDim2.new(orbStart.X.Scale, orbStart.X.Offset + delta.X, orbStart.Y.Scale, orbStart.Y.Offset + delta.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        rainDragging = false; orbDragging = false
    end
end)

