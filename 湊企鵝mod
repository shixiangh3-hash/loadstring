local function safeSet(object, property, value)
    if object then
        pcall(function()
            object[property] = value
        end)
    end
end

local function addCorner(object, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = object
end

local function rgbColor(speed, offset)
    return Color3.fromHSV(
        ((os.clock() * speed) + (offset or 0)) % 1,
        0.58,
        0.93
    )
end

local function addRGB(object, property)
    table.insert(rgbObjects, {
        object = object,
        property = property
    })
end

local function addStroke(object, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = thickness or 2
    stroke.Transparency = 0.08
    stroke.Parent = object
    addRGB(stroke, "Color")
    return stroke
end

RunService.RenderStepped:Connect(function()
    for index, data in ipairs(rgbObjects) do
        if data.object and data.object.Parent then
            pcall(function()
                data.object[data.property] =
                    rgbColor(0.08, index * 0.025)
            end)
        end
    end
end)

local function createButton(parent, y, text, color, height)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -30, 0, height or 40)
