local function playKillSound()
    if not killSoundEnabled or not currentKillSoundId then return end
    if os.clock() - lastPlayTime < 0.4 then return end
    lastPlayTime = os.clock()

    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. currentKillSoundId
    sound.Volume = 2
    SoundService:PlayLocalSound(sound)
    task.delay(5, function() if sound then sound:Destroy() end end)
end

local function processKillTarget(humanoid)
    if not humanoid then return end
    if targetStatus[humanoid] == "Done" then return end

    if humanoid.Health <= 0 then
        if targetStatus[humanoid] ~= "Done" then
            playKillSound()
            targetStatus[humanoid] = "Done"
            task.delay(10, function()
                if targetStatus[humanoid] == "Done" then targetStatus[humanoid] = nil end
            end)
        end
        return
    end

    if targetStatus[humanoid] == nil then
        targetStatus[humanoid] = "Playing"
        local diedConn
        diedConn = humanoid.Died:Connect(function()
            if targetStatus[humanoid] ~= "Done" then
                playKillSound()
                targetStatus[humanoid] = "Done"
                task.delay(10, function()
                    if targetStatus[humanoid] == "Done" then targetStatus[humanoid] = nil end
                end)
            end
            if diedConn then diedConn:Disconnect() end
        end)

        task.delay(8, function()
            if diedConn then diedConn:Disconnect() end
            if targetStatus[humanoid] == "Playing" then
                targetStatus[humanoid] = nil
            end
        end)
    end
end

local function doHitRegistration()
    local camera = Workspace.CurrentCamera
    local myChar = Player.Character
    if not camera or not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end

    local myPos = myChar.HumanoidRootPart.Position

    local viewportSize = camera.ViewportSize
    local centerRay = camera:ViewportPointToRay(viewportSize.X / 2, viewportSize.Y / 2)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {myChar}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local result = Workspace:Raycast(centerRay.Origin, centerRay.Direction * 5000, rayParams)
    local targetPos = nil

    if result and result.Instance then
        local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
        local humanoid = hitModel and hitModel:FindFirstChildOfClass("Humanoid")
        if humanoid then
            processKillTarget(humanoid)
        else
            targetPos = result.Position
        end
    end

    local targetsToCheck = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then table.insert(targetsToCheck, p.Character) end
    end
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and child:FindFirstChild("Humanoid") and child ~= myChar then table.insert(targetsToCheck, child) end
    end

    for _, model in ipairs(targetsToCheck) do
        local hrp = model:FindFirstChild("HumanoidRootPart")
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        
        if hrp and humanoid then
            if targetPos and (targetPos - hrp.Position).Magnitude <= 30 then
                processKillTarget(humanoid)
            end
            if (myPos - hrp.Position).Magnitude <= 20 then
                processKillTarget(humanoid)
            end
        end
    end
end

local function startFiring()
    if not killSoundEnabled then return end
    isFiring = true
