-- 擊殺音效核心邏輯
local killSoundEnabled = false
local currentKillSoundId = nil
local lastPlayTime = 0
local targetStatus = {} 
local isFiring = false
local fireLoopTask = nil

local function playKillSound()
    if not killSoundEnabled or not currentKillSoundId then return end
    if os.clock() - lastPlayTime < 0.4 then return end
    lastPlayTime = os.clock()
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. currentKillSoundId
    sound.Volume = 2
    SoundService:PlayLocalSound(sound)
    task.delay(5, function() if sound then sound:Destroy() end end)
end

local function processKillTarget(humanoid)
    if not humanoid or targetStatus[humanoid] == "Done" then return end
    if humanoid.Health <= 0 then
        playKillSound()
        targetStatus[humanoid] = "Done"
        task.delay(10, function() if targetStatus[humanoid] == "Done" then targetStatus[humanoid] = nil end end)
        return
    end
    if targetStatus[humanoid] == nil then
        targetStatus[humanoid] = "Playing"
        local diedConn
        diedConn = humanoid.Died:Connect(function()
            if targetStatus[humanoid] ~= "Done" then
                playKillSound()
                targetStatus[humanoid] = "Done"
                task.delay(10, function() if targetStatus[humanoid] == "Done" then targetStatus[humanoid] = nil end end)
            end
            if diedConn then diedConn:Disconnect() end
        end)
        task.delay(8, function()
            if diedConn then diedConn:Disconnect() end
            if targetStatus[humanoid] == "Playing" then targetStatus[humanoid] = nil end
        end)
    end
end

local function doHitRegistration()
    local camera = Workspace.CurrentCamera
    local myChar = Player.Character
    if not camera or not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myPos = myChar.HumanoidRootPart.Position

    local ray = camera:ViewportPointToRay(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {myChar}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local result = Workspace:Raycast(ray.Origin, ray.Direction * 5000, rayParams)
    local targetPos = nil

    if result and result.Instance then
        local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
        local humanoid = hitModel and hitModel:FindFirstChildOfClass("Humanoid")
        if humanoid then processKillTarget(humanoid) else targetPos = result.Position end
    end

    local targets = {}
    for _, p in ipairs(Players:GetPlayers()) do if p ~= Player and p.Character then table.insert(targets, p.Character) end end
    for _, c in ipairs(Workspace:GetChildren()) do if c:IsA("Model") and c:FindFirstChild("Humanoid") and c ~= myChar then table.insert(targets, c) end end

    for _, model in ipairs(targets) do
        local hrp = model:FindFirstChild("HumanoidRootPart")
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if hrp and humanoid then
            if targetPos and (targetPos - hrp.Position).Magnitude <= 30 then processKillTarget(humanoid) end
            if (myPos - hrp.Position).Magnitude <= 20 then processKillTarget(humanoid) end
        end
    end
end

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not killSoundEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isFiring = true
        if fireLoopTask then return end
        fireLoopTask = task.spawn(function()
            while isFiring do
                if killSoundEnabled then doHitRegistration() end
                task.wait(0.15)
            end
            fireLoopTask = nil
        end)
    end
end)
UIS.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isFiring = false end
end)

