    fpsGrayAtmosphere.Color = Color3.fromRGB(155, 155, 155)
    fpsGrayAtmosphere.Decay = Color3.fromRGB(155, 155, 155)
    fpsGrayAtmosphere.Density = 1
    fpsGrayAtmosphere.Haze = 10
    fpsGrayAtmosphere.Glare = 0
    fpsGrayAtmosphere.Parent = Lighting

    savedLighting.__FPS_Ambient = Lighting.Ambient
    savedLighting.__FPS_OutdoorAmbient = Lighting.OutdoorAmbient
    savedLighting.__FPS_Top = Lighting.ColorShift_Top
    savedLighting.__FPS_Bottom = Lighting.ColorShift_Bottom
    savedLighting.__FPS_Fog = Lighting.FogColor
    savedLighting.__FPS_FogStart = Lighting.FogStart
    savedLighting.__FPS_FogEnd = Lighting.FogEnd

    Lighting.Ambient = Color3.fromRGB(135, 135, 135)
    Lighting.OutdoorAmbient = Color3.fromRGB(145, 145, 145)
    Lighting.ColorShift_Top = Color3.fromRGB(145, 145, 145)
    Lighting.ColorShift_Bottom = Color3.fromRGB(135, 135, 135)
    Lighting.FogColor = Color3.fromRGB(155, 155, 155)
