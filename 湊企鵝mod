local function createOwned(className, name)
    local object = Instance.new(className)
    object.Name = PREFIX .. name
    object.Parent = Lighting
    return object
end

local function clearOwned()
    for _, object in ipairs(Lighting:GetChildren()) do
        if object.Name:sub(1, #PREFIX) == PREFIX then
            object:Destroy()
        end
    end
end

local function baseLighting()
    Lighting.Technology = Enum.Technology.Future
    Lighting.GlobalShadows = true
    Lighting.ShadowSoftness = 0.09
    Lighting.EnvironmentDiffuseScale = 0.86
    Lighting.EnvironmentSpecularScale = 0.94
end

local function effects(color, density, haze, tint, brightness, contrast, saturation)
    local atmosphere = createOwned("Atmosphere", "Atmosphere")
    atmosphere.Color = color
    atmosphere.Density = density
    atmosphere.Haze = haze
    atmosphere.Glare = 0.04

    local correction = createOwned("ColorCorrectionEffect", "Color")
    correction.TintColor = tint
    correction.Brightness = brightness
    correction.Contrast = contrast
    correction.Saturation = saturation

    local bloom = createOwned("BloomEffect", "Bloom")
    bloom.Intensity = 0.08
    bloom.Size = 20
    bloom.Threshold = 1.1
end

