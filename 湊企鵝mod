local function enableFPS()
    if fpsEnabled then showToast("增加FPS已載入", "小翔製作"); return end
    fpsEnabled = true; table.clear(savedParts); table.clear(savedVisuals)

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(gui) and not obj.Name:find(PREFIX) then
            table.insert(savedParts, {part = obj, material = obj.Material, color = obj.Color, reflectance = obj.Reflectance, castShadow = obj.CastShadow, transparency = obj.Transparency})
            obj.Material = Enum.Material.SmoothPlastic; obj.Reflectance = 0; obj.CastShadow = false
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SurfaceAppearance") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
            local data = {object = obj, enabled = nil, transparency = nil}
            if obj:IsA("Decal") or obj:IsA("Texture") then data.transparency = obj.Transparency; obj.Transparency = 1
            elseif obj:IsA("SurfaceAppearance") then data.enabled = obj.Enabled; obj.Enabled = false
            else data.enabled = obj.Enabled; obj.Enabled = false end
            table.insert(savedVisuals, data)
        end
    end
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Sky") then table.insert(savedSky, obj:Clone()); obj:Destroy() end
