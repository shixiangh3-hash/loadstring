        end
        if skySavedAtmosphere then
            skySavedAtmosphere.Parent = Lighting
            skySavedAtmosphere = nil
        end
        Lighting.TimeOfDay = skySavedTimeOfDay
        Lighting.OutdoorAmbient = skySavedOutdoorAmbient
        Lighting.Brightness = skySavedBrightness
        if not silent then showToast("已恢復遊戲原本天空") end
    end

