--====================================================
-- 雨 / 雪 / 閃電
--====================================================
local rainAmount = 0.55
local snowAmount = 0.55
local rainEnabled = false
local snowEnabled = false
local thunderEnabled = false
local rainFolder, rainConnection, rainDrops = nil, nil, {}
local snowFolder, snowConnection, snowFlakes = nil, nil, {}
local thunderConnection = nil
local thunderGui = nil
local function stopRain()
    if rainConnection then rainConnection:Disconnect(); rainConnection = nil end
    if rainFolder then rainFolder:Destroy(); rainFolder = nil end
    table.clear(rainDrops); rainEnabled = false
    stopRainSound()
end
local function stopSnow()
    if snowConnection then snowConnection:Disconnect(); snowConnection = nil end
    if snowFolder then snowFolder:Destroy(); snowFolder = nil end
    table.clear(snowFlakes); snowEnabled = false
end
local function stopThunder()
    if thunderConnection then thunderConnection:Disconnect(); thunderConnection = nil end
    if thunderGui then thunderGui:Destroy(); thunderGui = nil end
    thunderEnabled = false
end
local function rainCount() return math.floor(100 + rainAmount * 900) end
local function resizeRain()
    if not rainFolder then return end
    local folder = rainFolder:FindFirstChild("Drops"); if not folder then return end
    while #rainDrops < rainCount() do
        local part = Instance.new("Part")
        part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
        part.Material = Enum.Material.Neon
        part.Color = Color3.fromRGB(165, 198, 230)
        part.Transparency = 0.18
