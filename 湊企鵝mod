        end
        return nil
    end)
    if s and data and type(data) == "table" then presetSaves = data; return true end
    return false
end
local function savePresetData()
    pcall(function()
        if writefile then writefile(PRESET_FILE, game:GetService("HttpService"):JSONEncode(presetSaves)) end
    end)
end

local function getCurrentSnapshot()
    return {
        lightEnabled = lightEnabled,
        lightMode = currentLightMode,
        fogAmount = fogAmount,
        skyName = currentSkyPresetName,
        weather = currentWeather,
        rainAmount = rainAmount,
        snowAmount = snowAmount,
        crosshair = currentCrosshair,
        crosshairScale = crosshairScale,
        lowHp = lowHpEnabled,
        fpsCounter = fpsCounterEnabled
    }
end

local function resetAll()
    if lightEnabled then turnOffLight() end
    if currentSkyPresetName then restoreOriginalSkyFn(true) end
    stopRainFn(); stopSnowFn(); stopThunderFn()
    thunderButton.Text = "閃電打雷"
    weatherButton.Text = "目前天氣：晴天"
    currentWeather = "晴天"
    removeRotatingCrosshair(); removeTechCrosshair(); removeBlackDiamondCrosshair()
    currentCrosshair = "無"
    if lowHpEnabled then lowHpToggleFn(true) end
    if fpsCounterEnabled then fpsCounterToggleFn(true) end
end

local function applySnapshot(data)
    resetAll()
    task.wait(0.1)

    if data.lightEnabled and data.lightMode then
        selectMode(data.lightMode, data.lightMode == "預設" and "預設光影" or data.lightMode)
    end
    if data.fogAmount then fogAmount = data.fogAmount end
    if data.skyName then
        local skyPresets = {
            { name = "粉红日落", sameId = "rbxassetid://151165214" },
            { name = "Skeleton 风格", sameId = "rbxassetid://169585459" },
            { name = "末日红天", faces = { Bk = "rbxassetid://1012890", Dn = "rbxassetid://1012891", Ft = "rbxassetid://1012887", Lf = "rbxassetid://1012889", Rt = "rbxassetid://1012888", Up = "rbxassetid://1014449" } },
            { name = "c00lkidd", sameId = "rbxassetid://8408806737" },
            { name = "夜空", faces = { Bk = "rbxassetid://2503254921", Dn = "rbxassetid://2503255146", Ft = "rbxassetid://2503255274", Lf = "rbxassetid://2503255403", Rt = "rbxassetid://2503255557", Up = "rbxassetid://2503255747" }, isDark = true },
            { name = "Nyan Cat", sameId = "rbxassetid://50767914" },
            { name = "Spongebob", sameId = "rbxassetid://92663158118274" },
            { name = "Matrix", sameId = "rbxassetid://191546360" }
        }
        for _, p in ipairs(skyPresets) do
            if p.name == data.skyName then
                applySkyPresetFn(p, true)
                break
            end
        end
    end
    if data.rainAmount then rainAmount = data.rainAmount end
    if data.snowAmount then snowAmount = data.snowAmount end
    if data.weather == "下雨" then startRainFn()
    elseif data.weather == "下雪" then startSnowFn()
    elseif data.weather == "閃電" then startRainFn(); task.wait(0.1); startThunderFn()
    end
    if data.crosshairScale then crosshairScale = data.crosshairScale end
    if data.crosshair == "旋轉" then createRotatingCrosshairFn(); currentCrosshair = "旋轉"
    elseif data.crosshair == "科技" then createTechCrosshairFn(); currentCrosshair = "科技"
    elseif data.crosshair == "黑色菱形" then createBlackDiamondCrosshairFn(); currentCrosshair = "黑色菱形"
    end
    if data.lowHp and not lowHpEnabled then lowHpToggleFn(true) end
    if data.fpsCounter and not fpsCounterEnabled then fpsCounterToggleFn(true) end
end

