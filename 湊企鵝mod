    local fkc = Instance.new("UICorner"); fkc.CornerRadius = UDim.new(0, 20); fkc.Parent = fogKnob

    local fogDragging = false
    local function updateFogAmount(input)
        local width = math.max(fogTrack.AbsoluteSize.X, 1)
        local x = input.Position.X - fogTrack.AbsolutePosition.X
        fogAmount = math.clamp(x / width, 0, 1)
        fogKnob.Position = UDim2.new(fogAmount, -12, 0.5, -12)
        if fogAmount < 0.34 then fogAmountLabel.Text = "霧量：小"
        elseif fogAmount < 0.67 then fogAmountLabel.Text = "霧量：中"
        else fogAmountLabel.Text = "霧量：大" end
        local atm = Lighting:FindFirstChild(PREFIX .. "FogAtmosphere")
        if atm then
            atm.Density = fogAmount * 0.8
            atm.Haze = fogAmount * 2
        end
        Lighting.FogEnd = 5000 - fogAmount * 4900
    end

    fogTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            fogDragging = true; updateFogAmount(input)
