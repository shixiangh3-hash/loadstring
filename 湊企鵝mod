local function startCycle()
    cycleToken += 1; local token = cycleToken
    cycle = true; lightEnabled = true; toggleButton.Text = "關閉光影"
    showToast("日夜循環以載入", "小翔製作")
    task.spawn(function()
        while cycle and token == cycleToken do
            applyDay(); statusLabel.Text = "目前狀態：日夜循環｜白天"; task.wait(180)
            if not cycle or token ~= cycleToken then break end
            applySunset(); statusLabel.Text = "目前狀態：日夜循環｜夕陽"; task.wait(30)
            if not cycle or token ~= cycleToken then break end
            applyNight(); statusLabel.Text = "目前狀態：日夜循環｜夜間"; task.wait(60)
        end
    end)
end

