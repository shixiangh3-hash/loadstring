local function startCycle()
    cycleToken += 1; local token = cycleToken
    cycle = true; lightEnabled = true; toggleButton.Text = "關閉光影"
    showToast("日夜循環以載入", "小翔製作")
    task.spawn(function()
        while cycle and token == cycleToken do
            applyDay(); statusLabel.Text = "目前狀態：日夜循環｜白天"; task.wait(180)
            if not cycle or token ~= cycleToken then break end
            applySunset(); statusLabel.Text = "目前狀態：日夜循環｜夕陽"; task.wait(30)
            if not cycle or token ~= cycleToken then break end
            applyNight(); statusLabel.Text = "目前狀態：日夜循環｜夜間"; task.wait(60)
        end
    end)
end

--==================================================
-- 還原
--==================================================
local function restore()
    cycleToken += 1; cycle = false
    stopRain(); removeRotatingCrosshair(); removeTechCrosshair(); removeBlackDiamondCrosshair(); clearOwned()
    if fpsGrayEffect then fpsGrayEffect:Destroy(); fpsGrayEffect = nil end
    if fpsGrayAtmosphere then fpsGrayAtmosphere:Destroy(); fpsGrayAtmosphere = nil end
    for prop, val in pairs(savedLighting) do
        if tostring(prop):sub(1, 6) ~= "__FPS_" then safeSet(Lighting, prop, val) end
    end
    if savedLighting.__FPS_Ambient then
        Lighting.Ambient = savedLighting.__FPS_Ambient; Lighting.OutdoorAmbient = savedLighting.__FPS_OutdoorAmbient
        Lighting.ColorShift_Top = savedLighting.__FPS_Top; Lighting.ColorShift_Bottom = savedLighting.__FPS_Bottom
        Lighting.FogColor = savedLighting.__FPS_Fog; Lighting.FogStart = savedLighting.__FPS_FogStart; Lighting.FogEnd = savedLighting.__FPS_FogEnd
    end
    for prop, val in pairs(savedTerrain) do if Terrain then safeSet(Terrain, prop, val) end end
    for _, data in ipairs(savedParts) do
        if data.part and data.part.Parent then
            safeSet(data.part, "Material", data.material); safeSet(data.part, "Color", data.color)
            safeSet(data.part, "Reflectance", data.reflectance); safeSet(data.part, "CastShadow", data.castShadow)
            safeSet(data.part, "Transparency", data.transparency)
        end
    end
    for _, data in ipairs(savedVisuals) do
        if data.object and data.object.Parent then
            if data.transparency ~= nil then safeSet(data.object, "Transparency", data.transparency) end
            if data.enabled ~= nil then safeSet(data.object, "Enabled", data.enabled) end
        end
    end
    for _, sky in ipairs(savedSky) do if sky then sky:Clone().Parent = Lighting end end
    for _, effect in ipairs(savedEffects) do if effect then effect:Clone().Parent = Lighting end end
    table.clear(savedParts); table.clear(savedVisuals); table.clear(savedSky)
    fpsEnabled = false; minecraftEnabled = false; lightEnabled = false
    blackTextureEnabled = false
    stretchEnabled = false
    if fpsButton then fpsButton.Text = "增加FPS" end
    if minecraftButton then minecraftButton.Text = "麥塊紋理包" end
    if blackTextureButton then blackTextureButton.Text = "黑色紋理" end
    if stretchButton then stretchButton.Text = "螢幕拉伸 (640x480)" end
    if rotationButton then rotationButton.Text = "開啟旋轉準心" end
    if techButton then techButton.Text = "開啟科技準心" end
    if blackDiamondButton then blackDiamondButton.Text = "開啟黑色菱形準星" end
end

