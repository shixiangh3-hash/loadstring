local function showToast(text, sub)
    toastToken += 1
    local token = toastToken

    toast.Text = text
    toastSub.Text = sub or ""

    toast.BackgroundTransparency = 0.1
    toast.TextTransparency = 0
    toastSub.TextTransparency = 0
    toastStroke.Transparency = 0.12

    task.delay(2.4, function()
        if token ~= toastToken then
            return
        end

        local info = TweenInfo.new(0.6)

        TweenService:Create(toast, info, {
            BackgroundTransparency = 1,
            TextTransparency = 1
        }):Play()

        TweenService:Create(toastSub, info, {
            TextTransparency = 1
        }):Play()

        TweenService:Create(toastStroke, info, {
            Transparency = 1
        }):Play()
    end)
end

