local savedLighting = {}
local savedTerrain = {}
for _, p in ipairs({"Technology","GlobalShadows","Brightness","ClockTime","ExposureCompensation","Ambient","OutdoorAmbient","ColorShift_Top","ColorShift_Bottom","EnvironmentDiffuseScale","EnvironmentSpecularScale","ShadowSoftness","FogColor","FogStart","FogEnd"}) do
    local ok, v = pcall(function() return Lighting[p] end)
    if ok then savedLighting[p] = v end
end
if Terrain then
    for _, p in ipairs({"WaterColor","WaterReflectance","WaterTransparency","WaterWaveSize","WaterWaveSpeed"}) do
        local ok, v = pcall(function() return Terrain[p] end)
        if ok then savedTerrain[p] = v end
    end
end
local function clearOwned()
    for _, o in ipairs(Lighting:GetChildren()) do
        if o.Name:sub(1, #PREFIX) == PREFIX then o:Destroy() end
    end
end
local function clearSkyAndFog()
    for _, o in ipairs(Lighting:GetChildren()) do if o:IsA("Sky") then o:Destroy() end end
    Lighting.FogStart = 100000
    Lighting.FogEnd = 100000
    Lighting.FogColor = Color3.fromRGB(255, 255, 255)
end
local function baseLighting()
    Lighting.Technology = Enum.Technology.Future
    Lighting.GlobalShadows = true
    Lighting.ShadowSoftness = 0.09
    Lighting.EnvironmentDiffuseScale = 0.86
    Lighting.EnvironmentSpecularScale = 0.94
end
local function applyWaterReflection()
    if Terrain then
        pcall(function()
            Terrain.WaterReflectance = 0.65
            Terrain.WaterTransparency = 0.35
            Terrain.WaterWaveSize = 0.3
            Terrain.WaterWaveSpeed = 12
        end)
    end
end
local function applyPreset()
    clearOwned(); clearSkyAndFog(); baseLighting(); applyWaterReflection()
    Lighting.ClockTime = 16.55; Lighting.Brightness = 1.95
    Lighting.ExposureCompensation = -0.01; Lighting.Ambient = Color3.fromRGB(68, 76, 92)
    Lighting.OutdoorAmbient = Color3.fromRGB(142, 158, 180)
    Lighting.FogColor = Color3.fromRGB(177, 210, 226); Lighting.FogStart = 700; Lighting.FogEnd = 100000
end
local function applyDay()
    clearOwned(); clearSkyAndFog(); baseLighting(); applyWaterReflection()
    Lighting.ClockTime = 13.1; Lighting.Brightness = 1.72
    Lighting.Ambient = Color3.fromRGB(78, 86, 103)
    Lighting.OutdoorAmbient = Color3.fromRGB(145, 158, 180)
    Lighting.FogColor = Color3.fromRGB(205, 221, 232)
end
local function applySunset()
    clearOwned(); clearSkyAndFog(); baseLighting(); applyWaterReflection()
    Lighting.ClockTime = 17.65; Lighting.Brightness = 2.05
    Lighting.ExposureCompensation = 0.08
    Lighting.Ambient = Color3.fromRGB(40, 20, 15)
    Lighting.OutdoorAmbient = Color3.fromRGB(180, 90, 50)
    Lighting.FogColor = Color3.fromRGB(250, 181, 120)
    Lighting.FogStart = 400; Lighting.FogEnd = 100000
    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = PREFIX .. "SunsetTint"
    cc.TintColor = Color3.fromRGB(255, 200, 150)
    cc.Brightness = 0.02
    cc.Contrast = 0.15
    cc.Saturation = 0.25
    cc.Parent = Lighting
    local at = Instance.new("Atmosphere")
    at.Name = PREFIX .. "SunsetAtmosphere"
    at.Color = Color3.fromRGB(255, 190, 130)
    at.Density = 0.05
    at.Haze = 0.5
    at.Glare = 0.1
    at.Parent = Lighting
end
local function applyNight()
    clearOwned(); clearSkyAndFog(); baseLighting(); applyWaterReflection()
    Lighting.ClockTime = 0.15; Lighting.Brightness = 1.16
    Lighting.Ambient = Color3.fromRGB(38, 47, 96)
    Lighting.OutdoorAmbient = Color3.fromRGB(62, 76, 145)
    Lighting.FogColor = Color3.fromRGB(34, 48, 112); Lighting.FogStart = 300; Lighting.FogEnd = 100000
end
local function applyFog()
    clearOwned(); clearSkyAndFog(); baseLighting()
    Lighting.ClockTime = 15
    Lighting.Brightness = 1.5
    Lighting.ExposureCompensation = 0
    Lighting.Ambient = Color3.fromRGB(90, 95, 105)
    Lighting.OutdoorAmbient = Color3.fromRGB(140, 145, 155)
    Lighting.FogColor = Color3.fromRGB(210, 215, 225)
    Lighting.FogStart = 0
    Lighting.FogEnd = 150
    local at = Instance.new("Atmosphere")
    at.Name = PREFIX .. "FogAtmosphere"
    at.Color = Color3.fromRGB(200, 205, 215)
    at.Density = 0.35
    at.Haze = 1.5
    at.Glare = 0
    at.Parent = Lighting
end
local lightEnabled = false
local function selectMode(mode, name)
    lightEnabled = true
    if mode == "預設" then applyPreset()
    elseif mode == "白天" then applyDay()
    elseif mode == "夜間" then applyNight()
    elseif mode == "起霧" then applyFog()
    else applySunset() end
    statusLabel.Text = "目前狀態：" .. name
    timeButton.Text = "目前時間：" .. name
    toggleButton.Text = "關閉光影"
end
toggleButton.Activated:Connect(function()
    if lightEnabled then
        clearOwned()
        for p, v in pairs(savedLighting) do pcall(function() Lighting[p] = v end) end
        if Terrain then for p, v in pairs(savedTerrain) do pcall(function() Terrain[p] = v end) end end
        lightEnabled = false
        statusLabel.Text = "目前狀態：已關閉"
        toggleButton.Text = "開啟光影"
    else
        selectMode("預設", "預設光影")
    end
end)
restoreButton.Activated:Connect(function()
    clearOwned()
    for p, v in pairs(savedLighting) do pcall(function() Lighting[p] = v end) end
    if Terrain then for p, v in pairs(savedTerrain) do pcall(function() Terrain[p] = v end) end end
    lightEnabled = false
    statusLabel.Text = "目前狀態：已恢復"
    toggleButton.Text = "開啟光影"
end)

