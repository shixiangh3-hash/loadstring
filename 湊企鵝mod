            table.insert(rainDrops, {part = part, offset = Vector3.new(math.random(-70, 70), math.random(-10, 70), math.random(-70, 70)), speed = math.random(78, 122)})
        end
        while #rainDrops > rainCount() do
            local drop = table.remove(rainDrops)
            if drop and drop.part then drop.part:Destroy() end
        end
    end
    startRainFn = function()
        stopRainFn(); stopSnowFn()
        rainEnabled = true
        rainFolder = Instance.new("Folder"); rainFolder.Name = PREFIX .. "Rain"; rainFolder.Parent = workspace
        local folder = Instance.new("Folder"); folder.Name = "Drops"; folder.Parent = rainFolder
        resizeRain()
        rainConnection = RunService.RenderStepped:Connect(function(dt)
            local camera = workspace.CurrentCamera; if not camera then return end
            for _, drop in ipairs(rainDrops) do
                if drop.part and drop.part.Parent then
                    drop.offset = drop.offset - Vector3.new(3.5, drop.speed, 2.2) * dt
                    if drop.offset.Y < -12 then
                        drop.offset = Vector3.new(math.random(-70, 70), math.random(46, 75), math.random(-70, 70))
                    end
                    drop.part.Position = camera.CFrame.Position + drop.offset
                end
            end
        end)
        weatherButton.Text = "目前天氣：下雨"
        currentWeather = "下雨"
    end
    local function snowCount() return math.floor(80 + snowAmount * 700) end
    local function resizeSnow()
        if not snowFolder then return end
        local folder = snowFolder:FindFirstChild("Flakes"); if not folder then return end
        while #snowFlakes < snowCount() do
            local part = Instance.new("Part")
            part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
            part.Material = Enum.Material.Neon
            part.Color = Color3.fromRGB(255, 255, 255)
            part.Transparency = 0.15
            local s = math.random(8, 18) / 100
            part.Size = Vector3.new(s, s, s)
            part.Shape = Enum.PartType.Ball
            part.Parent = folder
            table.insert(snowFlakes, {part = part, offset = Vector3.new(math.random(-70, 70), math.random(20, 70), math.random(-70, 70)), speed = math.random(15, 30), sway = math.random(0, 360)})
        end
        while #snowFlakes > snowCount() do
            local flake = table.remove(snowFlakes)
            if flake and flake.part then flake.part:Destroy() end
        end
    end
    startSnowFn = function()
        stopRainFn(); stopSnowFn()
        snowEnabled = true
        snowFolder = Instance.new("Folder"); snowFolder.Name = PREFIX .. "Snow"; snowFolder.Parent = workspace
        local folder = Instance.new("Folder"); folder.Name = "Flakes"; folder.Parent = snowFolder
        resizeSnow()
        snowConnection = RunService.RenderStepped:Connect(function(dt)
            local camera = workspace.CurrentCamera; if not camera then return end
            for _, flake in ipairs(snowFlakes) do
                if flake.part and flake.part.Parent then
                    flake.sway = flake.sway + dt * 2
                    local swayX = math.sin(flake.sway) * 2
                    flake.offset = flake.offset - Vector3.new(swayX, flake.speed, 1.5) * dt
                    if flake.offset.Y < -12 then
                        flake.offset = Vector3.new(math.random(-70, 70), math.random(50, 80), math.random(-70, 70))
                    end
                    flake.part.Position = camera.CFrame.Position + flake.offset
                end
            end
        end)
        weatherButton.Text = "目前天氣：下雪"
        currentWeather = "下雪"
    end
    startThunderFn = function()
        if not rainEnabled then
            showToast("請先開啟下雨才能使用閃電")
            return
        end
        if thunderEnabled then
            stopThunderFn()
            showToast("閃電已關閉")
            return
        end
