local function chooseMode(mode, name)
    cycleToken += 1
    cycling = false
    lightEnabled = true

    if mode == "預設光影" then
        applyPreset()
    elseif mode == "白天" then
        applyDay()
    elseif mode == "夜晚" then
        applyNight()
    elseif mode == "起霧" then
        applyFog()
    else
        applySunset()
    end

    statusLabel.Text = "目前狀態：" .. name
    timeButton.Text = "當前時間：" .. name
    toggleButton.Text = "關閉光影"

    main.Visible = true
    timeMenu.Visible = false
    weatherMenu.Visible = false
    settingMenu.Visible = false
    crosshairMenu.Visible = false

    showToast(name .. "以載入", "小翔製作")
end

