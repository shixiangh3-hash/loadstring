local function createOwned(className, name)
    local o = Instance.new(className); o.Name = PREFIX .. name; o.Parent = Lighting; return o
end

local function clearOwned()
    for _, o in ipairs(Lighting:GetChildren()) do
        if o.Name:sub(1, #PREFIX) == PREFIX then o:Destroy() end
    end
end

local function baseLighting()
    Lighting.Technology = Enum.Technology.Future
    Lighting.GlobalShadows = true; Lighting.ShadowSoftness = 0.09
    Lighting.EnvironmentDiffuseScale = 0.86; Lighting.EnvironmentSpecularScale = 0.94
end

local function effects(color, density, haze, tint, brightness, contrast, saturation)
    local at = createOwned("Atmosphere", "Atmosphere")
    at.Color = color; at.Density = density; at.Haze = haze; at.Glare = 0.04
    local cc = createOwned("ColorCorrectionEffect", "Color")
    cc.TintColor = tint; cc.Brightness = brightness; cc.Contrast = contrast; cc.Saturation = saturation
    local bl = createOwned("BloomEffect", "Bloom")
    bl.Intensity = 0.08; bl.Size = 20; bl.Threshold = 1.1
end

local function applyPreset()
    clearOwned(); baseLighting()
    Lighting.ClockTime = 16.55; Lighting.Brightness = 1.95
    Lighting.ExposureCompensation = -0.01; Lighting.Ambient = Color3.fromRGB(68, 76, 92)
    Lighting.OutdoorAmbient = Color3.fromRGB(142, 158, 180)
    Lighting.ColorShift_Top = Color3.fromRGB(224, 235, 238)
    Lighting.ColorShift_Bottom = Color3.fromRGB(214, 190, 155)
    Lighting.FogColor = Color3.fromRGB(177, 210, 226)
    Lighting.FogStart = 700; Lighting.FogEnd = 100000
    effects(Color3.fromRGB(185, 215, 230), 0.035, 0.2, Color3.fromRGB(248, 246, 238), 0, 0.22, 0.02)
end

