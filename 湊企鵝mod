local mvDragging = false
local function updateVol(input)
    local width = math.max(musicVolumeTrack.AbsoluteSize.X, 1)
    local x = input.Position.X - musicVolumeTrack.AbsolutePosition.X
    local ratio = math.clamp(x / width, 0, 1)
    musicVolume = ratio
    musicVolumeKnob.Position = UDim2.new(ratio, -12, 0.5, -12)
    musicVolumeLabel.Text = string.format("音量大小：%d%%", math.floor(ratio * 100))
    if musicSound then pcall(function() musicSound.Volume = musicVolume end) end
end
musicVolumeTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        mvDragging = true; updateVol(input)
    end
end)
musicVolumeKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then mvDragging = true end
end)
UIS.InputChanged:Connect(function(input)
    if mvDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateVol(input) end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then mvDragging = false end
end)

