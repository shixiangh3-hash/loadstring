    local skySavedOutdoorAmbient = Lighting.OutdoorAmbient
    local skySavedBrightness = Lighting.Brightness
    local skyGuardConnections = {}
    local isReapplying = false
    currentSkyPresetName = nil

    local function hideSkyAtmosphere()
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if atm and not skySavedAtmosphere then
            skySavedAtmosphere = atm
            atm.Parent = nil
        end
    end

    local function findPresetByName(name)
        for _, p in ipairs(skyPresets) do
            if p.name == name then return p end
        end
        return nil
    end

    local function doApplySky(preset)
        isReapplying = true
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("Sky") and obj.Name ~= SKY_NAME then obj:Destroy() end
        end
        local sky = Lighting:FindFirstChild(SKY_NAME)
        if not sky or not sky:IsA("Sky") then
            sky = Instance.new("Sky")
            sky.Name = SKY_NAME
            sky.Parent = Lighting
        end
        if preset.sameId then
            sky.SkyboxBk = preset.sameId; sky.SkyboxDn = preset.sameId
            sky.SkyboxFt = preset.sameId; sky.SkyboxLf = preset.sameId
            sky.SkyboxRt = preset.sameId; sky.SkyboxUp = preset.sameId
        elseif preset.faces then
            sky.SkyboxBk = preset.faces.Bk; sky.SkyboxDn = preset.faces.Dn
            sky.SkyboxFt = preset.faces.Ft; sky.SkyboxLf = preset.faces.Lf
            sky.SkyboxRt = preset.faces.Rt; sky.SkyboxUp = preset.faces.Up
        end
        if preset.isDark then
            hideSkyAtmosphere()
            Lighting.TimeOfDay = "00:00:00"
            Lighting.OutdoorAmbient = Color3.fromRGB(35, 25, 45)
            Lighting.Brightness = 1
        else
            if skySavedAtmosphere then
                skySavedAtmosphere.Parent = Lighting
                skySavedAtmosphere = nil
            end
            Lighting.TimeOfDay = skySavedTimeOfDay
            Lighting.OutdoorAmbient = skySavedOutdoorAmbient
            Lighting.Brightness = skySavedBrightness
        end
        task.defer(function() isReapplying = false end)
    end

    local function disconnectGuard()
        for _, conn in ipairs(skyGuardConnections) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(skyGuardConnections)
    end

    local function startSkyGuard()
        disconnectGuard()
        table.insert(skyGuardConnections, Lighting.ChildAdded:Connect(function(child)
            if isReapplying or not currentSkyPresetName then return end
            if child:IsA("Sky") and child.Name ~= SKY_NAME then
                task.defer(function()
                    local p = currentSkyPresetName and findPresetByName(currentSkyPresetName)
                    if p then doApplySky(p) end
                end)
            end
        end))
        table.insert(skyGuardConnections, Lighting.ChildRemoved:Connect(function(child)
            if isReapplying or not currentSkyPresetName then return end
            if child:IsA("Sky") and child.Name == SKY_NAME then
                task.defer(function()
                    local p = currentSkyPresetName and findPresetByName(currentSkyPresetName)
                    if p then doApplySky(p) end
                end)
            end
        end))
        table.insert(skyGuardConnections, Lighting:GetPropertyChangedSignal("ClockTime"):Connect(function()
            if isReapplying or not currentSkyPresetName then return end
            local p = findPresetByName(currentSkyPresetName)
            if p and p.isDark then
                if Lighting.ClockTime > 6 and Lighting.ClockTime < 18 then
                    task.defer(function()
                        if currentSkyPresetName then doApplySky(p) end
                    end)
                end
            end
        end))
    end

    applySkyPresetFn = function(preset, silent)
        currentSkyPresetName = preset.name
        doApplySky(preset)
        startSkyGuard()
        if not silent then showToast("天空已切換：" .. preset.name) end
