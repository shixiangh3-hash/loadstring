        flash.BackgroundTransparency = 1
        flash.BorderSizePixel = 0
        flash.ZIndex = 999999
        flash.Parent = thunderGui
        thunderTask = task.spawn(function()
            while thunderEnabled do
                task.wait(math.random(5, 12))
                if not thunderEnabled then break end
                if not flash or not flash.Parent then break end
                for i = 1, math.random(2, 3) do
                    if not thunderEnabled then break end
                    if flash and flash.Parent then
                        flash.BackgroundTransparency = 0.2
                        task.wait(0.05)
                        flash.BackgroundTransparency = 0.85
                        task.wait(0.08)
                    end
                end
                if flash and flash.Parent then flash.BackgroundTransparency = 1 end
                if not thunderEnabled then break end
                pcall(function()
                    local s = Instance.new("Sound")
                    s.SoundId = THUNDER_SOUND
                    s.Volume = 2
                    s.PlaybackSpeed = 0.7
                    s.Parent = SoundService
                    s:Play()
                    task.delay(5, function() s:Destroy() end)
                end)
            end
            if flash and flash.Parent then flash.BackgroundTransparency = 1 end
        end)
        showToast("閃電已開啟")
        currentWeather = "閃電"
    end
end

