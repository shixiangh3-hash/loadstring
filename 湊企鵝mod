local function safeSet(obj, prop, val) if obj then pcall(function() obj[prop] = val end) end end

local function addCorner(obj, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = obj
end

local function rgbColor(speed, offset)
    return Color3.fromHSV(((os.clock() * speed) + (offset or 0)) % 1, 0.58, 0.93)
end

local function addRGB(obj, prop) table.insert(rgbObjects, {object = obj, property = prop}) end

local function addStroke(obj, thickness)
    local s = Instance.new("UIStroke"); s.Thickness = thickness or 2
    s.Transparency = 0.08; s.Parent = obj; addRGB(s, "Color"); return s
end

RunService.RenderStepped:Connect(function()
    for i, data in ipairs(rgbObjects) do
        if data.object and data.object.Parent then
            pcall(function() data.object[data.property] = rgbColor(0.08, i * 0.025) end)
        end
    end
end)

