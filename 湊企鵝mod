local function saveMusicData()
    local success, err = pcall(function()
        if writefile then
            writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode(musicSaves))
        end
    end)
    if not success then
        warn("存檔失敗（執行器可能不支援 writefile）：" .. tostring(err))
    end
end

local function loadMusicData()
    local success, data = pcall(function()
        if readfile and isfile and isfile(SAVE_FILE) then
            return game:GetService("HttpService"):JSONDecode(readfile(SAVE_FILE))
        end
        return nil
    end)

    if success and data and type(data) == "table" then
        musicSaves = data
        return true
    end
    return false
end

