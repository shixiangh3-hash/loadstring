    sky.SkyboxBk = skyId; sky.SkyboxDn = skyId; sky.SkyboxFt = skyId
    sky.SkyboxLf = skyId; sky.SkyboxRt = skyId; sky.SkyboxUp = skyId
    sky.StarCount = 5000; sky.CelestialBodiesShown = true
    effects(Color3.fromRGB(82, 112, 228), 0.055, 0.3, Color3.fromRGB(175, 198, 255), 0.035, 0.27, 0.1)
