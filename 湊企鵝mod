local function enableFPS()
    if fpsEnabled then
        showToast("增加 FPS 已載入", "小翔製作")
        return
    end

    fpsEnabled = true
    table.clear(savedParts)
    table.clear(savedVisuals)

    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("BasePart")
            and not object:IsDescendantOf(gui)
            and not object.Name:find(PREFIX) then

            table.insert(savedParts, {
                part = object,
                material = object.Material,
                color = object.Color,
                reflectance = object.Reflectance,
                castShadow = object.CastShadow,
                transparency = object.Transparency
            })

            object.Material = Enum.Material.SmoothPlastic
            object.Reflectance = 0
            object.CastShadow = false
        end
    end

    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Decal")
            or object:IsA("Texture")
            or object:IsA("SurfaceAppearance")
            or object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam")
            or object:IsA("Smoke")
            or object:IsA("Fire")
            or object:IsA("Sparkles")
            or object:IsA("PointLight")
            or object:IsA("SpotLight")
            or object:IsA("SurfaceLight") then

            local data = {
                object = object,
                enabled = nil,
                transparency = nil
            }

            if object:IsA("Decal") or object:IsA("Texture") then
                data.transparency = object.Transparency
                object.Transparency = 1
            elseif object:IsA("SurfaceAppearance") then
                data.enabled = object.Enabled
                object.Enabled = false
            else
                data.enabled = object.Enabled
                object.Enabled = false
            end

            table.insert(savedVisuals, data)
        end
    end

    for _, object in ipairs(Lighting:GetChildren()) do
        if object:IsA("Sky") then
            table.insert(savedSky, object:Clone())
            object:Destroy()
        end
    end

    fpsGrayEffect = Instance.new("ColorCorrectionEffect")
    fpsGrayEffect.Name = PREFIX .. "FPSGray"
    fpsGrayEffect.Brightness = -0.03
    fpsGrayEffect.Contrast = -0.02
    fpsGrayEffect.Saturation = -1
    fpsGrayEffect.TintColor = Color3.fromRGB(185, 185, 185)
    fpsGrayEffect.Parent = Lighting

    fpsGrayAtmosphere = Instance.new("Atmosphere")
