    restore()

    toggle.Text = "開啟光影"
    status.Text = "目前狀態：已恢復"
    timeButton.Text = "當前時間：夕陽"
    weatherButton.Text = "當前天氣：晴天"
    fpsButton.Text = "增加 FPS"

    panel.Visible = true
    timeMenu.Visible = false
    weatherMenu.Visible = false
    settingMenu.Visible = false
end)

--==================================================
-- 雨量滑桿：支援滑鼠與手機觸控
--==================================================

local function updateRainFromInput(input)
    local trackWidth = math.max(rainTrack.AbsoluteSize.X, 1)
    local relativeX = input.Position.X - rainTrack.AbsolutePosition.X

    local value = math.clamp(
        relativeX / trackWidth,
        0.05,
        1
    )

    rainAmount = value
    rainKnob.Position = UDim2.new(
        rainAmount,
        -12,
        0.5,
        -12
    )

    if rainAmount < 0.34 then
        rainLabel.Text = "雨量：小"
    elseif rainAmount < 0.67 then
        rainLabel.Text = "雨量：中"
    else
        rainLabel.Text = "雨量：大"
    end

    if raining then
        resizeRain()
    end
end

rainTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        rainDragging = true
        updateRainFromInput(input)
    end
end)

rainKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        rainDragging = true
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if rainDragging
        and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then

        updateRainFromInput(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        rainDragging = false
        orbDragging = false
    end
end)

--==================================================
-- 浮動按鈕拖曳：支援滑鼠與手機觸控
--==================================================

orb.Activated:Connect(function()
    if orbMoved then
        orbMoved = false
        return
    end

    panel.Visible = not panel.Visible

    if panel.Visible then
        timeMenu.Visible = false
        weatherMenu.Visible = false
        settingMenu.Visible = false
    end
end)

orb.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        orbDragging = true
        orbMoved = false
        dragStart = input.Position
        orbStart = orb.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if orbDragging
        and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then

        local delta = input.Position - dragStart

        if delta.Magnitude > 8 then
            orbMoved = true
        end

        orb.Position = UDim2.new(
            orbStart.X.Scale,
            orbStart.X.Offset + delta.X,
            orbStart.Y.Scale,
            orbStart.Y.Offset + delta.Y
        )
    end
end)

