--==================================================

local function chooseTime(mode, displayName)
    cycleId += 1
    cycling = false
    enabled = true

    applyTimeMode(mode)

    status.Text = "目前狀態：" .. displayName
    timeButton.Text = "當前時間：" .. displayName
    toggle.Text = "關閉光影"

    timeMenu.Visible = false
    weatherMenu.Visible = false
    settingMenu.Visible = false
    panel.Visible = true
end

presetButton.Activated:Connect(function()
    chooseTime("預設光影", "預設光影")
end)

dayButton.Activated:Connect(function()
    chooseTime("白天", "白天")
end)

nightButton.Activated:Connect(function()
    chooseTime("夜晚", "夜晚／星空")
end)

fogButton.Activated:Connect(function()
    chooseTime("起霧", "起霧")
end)

sunsetButton.Activated:Connect(function()
    chooseTime("夕陽", "夕陽")
end)

cycleButton.Activated:Connect(function()
    cycleId += 1
    local currentCycle = cycleId

    cycling = true
    enabled = true
    toggle.Text = "關閉光影"

    timeMenu.Visible = false
    panel.Visible = true

    task.spawn(function()
        while cycling and currentCycle == cycleId do
            applyDay()
            status.Text = "目前狀態：日夜循環｜白天"
            timeButton.Text = "當前時間：日夜循環"

            task.wait(180)

            if not cycling or currentCycle ~= cycleId then
                break
            end

            applySunset()
            status.Text = "目前狀態：日夜循環｜夕陽"

            task.wait(30)

            if not cycling or currentCycle ~= cycleId then
                break
            end

            applyNight()
            status.Text = "目前狀態：日夜循環｜夜晚"

            task.wait(60)
        end
    end)
end)

