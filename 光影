--==================================================
-- 3D 雨系統
--==================================================

local function stopRain()
    if rainConnection then
        rainConnection:Disconnect()
        rainConnection = nil
    end

    if rainFolder then
        rainFolder:Destroy()
        rainFolder = nil
    end

    table.clear(rainDrops)
    raining = false

    for _, object in ipairs(Lighting:GetChildren()) do
        if object.Name:sub(1, #PREFIX) == PREFIX
            and object.Name:find("Weather") then
            object:Destroy()
        end
    end
end

local function targetRainCount()
    return math.floor(100 + rainAmount * 900)
end

local function resizeRain()
    if not rainFolder then
        return
    end

    local dropsFolder = rainFolder:FindFirstChild("Drops")
    if not dropsFolder then
        return
    end

    while #rainDrops < targetRainCount() do
        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Material = Enum.Material.Neon
        part.Color = Color3.fromRGB(165, 198, 230)
        part.Transparency = 0.18
        part.Size = Vector3.new(
            0.08,
            math.random(34, 58) / 10,
            0.08
        )
        part.Parent = dropsFolder

        table.insert(rainDrops, {
            part = part,
            offset = Vector3.new(
                math.random(-70, 70),
                math.random(-10, 70),
                math.random(-70, 70)
            ),
            speed = math.random(78, 122)
        })
    end

    while #rainDrops > targetRainCount() do
        local drop = table.remove(rainDrops)
        if drop and drop.part then
            drop.part:Destroy()
        end
    end
end

local function startRain()
    stopRain()
    raining = true

    rainFolder = Instance.new("Folder")
    rainFolder.Name = PREFIX .. "Weather_Rain"
    rainFolder.Parent = workspace

    local dropsFolder = Instance.new("Folder")
    dropsFolder.Name = "Drops"
    dropsFolder.Parent = rainFolder

    resizeRain()

    local atmosphere = createOwned(
        "Atmosphere",
        "Weather_Atmosphere"
    )
    atmosphere.Color = Color3.fromRGB(150, 165, 185)
    atmosphere.Decay = Color3.fromRGB(80, 95, 115)
    atmosphere.Density = 0.4
    atmosphere.Haze = 2.5
    atmosphere.Glare = 0

    local colorCorrection = createOwned(
        "ColorCorrectionEffect",
        "Weather_Color"
    )
    colorCorrection.Brightness = -0.06
    colorCorrection.Contrast = 0.14
    colorCorrection.Saturation = -0.3
    colorCorrection.TintColor = Color3.fromRGB(178, 198, 222)

    Lighting.Ambient = Color3.fromRGB(52, 62, 76)
    Lighting.OutdoorAmbient = Color3.fromRGB(66, 78, 94)
    Lighting.FogColor = Color3.fromRGB(104, 118, 136)
    Lighting.FogStart = 24
    Lighting.FogEnd = 390

    setupCloud(
        Color3.fromRGB(80, 88, 100),
        1,
        0.9
    )

    rainConnection = RunService.RenderStepped:Connect(function(deltaTime)
        local camera = workspace.CurrentCamera
        if not camera then
            return
        end

        local center = camera.CFrame.Position

        for _, drop in ipairs(rainDrops) do
            if drop.part and drop.part.Parent then
                drop.offset -= Vector3.new(
                    3.5,
                    drop.speed,
                    2.2
                ) * deltaTime

                if drop.offset.Y < -12 then
                    drop.offset = Vector3.new(
                        math.random(-70, 70),
                        math.random(46, 75),
                        math.random(-70, 70)
                    )
                end

                drop.part.Position = center + drop.offset
            end
        end
    end)
end

--==================================================
-- 增加 FPS
--==================================================

local function enableFPS()
    if fpsEnabled then
        return
    end

    fpsEnabled = true
    table.clear(savedParts)

    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("BasePart")
            and not object:IsDescendantOf(gui)
            and not object.Name:find(PREFIX) then

            table.insert(savedParts, {
                part = object,
                material = object.Material,
                color = object.Color,
                reflectance = object.Reflectance,
                castShadow = object.CastShadow
            })

            pcall(function()
                object.Material = Enum.Material.SmoothPlastic
                object.Reflectance = 0
                object.CastShadow = false
            end)
        end
    end

    -- 降低部分後製效果負擔，但不移除目前的光影介面
    for _, object in ipairs(Lighting:GetChildren()) do
        if object:IsA("BloomEffect")
            or object:IsA("SunRaysEffect")
            or object:IsA("DepthOfFieldEffect") then
            pcall(function()
                object.Enabled = false
            end)
        end
    end
end

--==================================================
-- 還原所有設定
--==================================================

local function restore()
    cycleId += 1
    cycling = false

    stopRain()
    clearOwnedEffects()

    for object, properties in pairs(savedProperties) do
        if object and object.Parent then
            for propertyName, value in pairs(properties) do
                pcall(function()
                    object[propertyName] = value
                end)
            end
        end
    end

    for _, object in ipairs(savedEffects) do
        if object then
            object:Clone().Parent = Lighting
        end
    end

    for _, data in ipairs(savedParts) do
        if data.part and data.part.Parent then
            pcall(function()
                data.part.Material = data.material
                data.part.Color = data.color
                data.part.Reflectance = data.reflectance
                data.part.CastShadow = data.castShadow
            end)
        end
    end

    table.clear(savedParts)
    fpsEnabled = false
    enabled = false
end

