--==================================================
-- 儲存原始 Lighting 設定
--==================================================

local function saveProperty(object, propertyName)
    if not object then
        return
    end

    local success, value = pcall(function()
        return object[propertyName]
    end)

    if success then
        savedProperties[object] = savedProperties[object] or {}
        savedProperties[object][propertyName] = value
    end
end

for _, propertyName in ipairs({
    "Technology",
    "GlobalShadows",
    "Brightness",
    "ClockTime",
    "ExposureCompensation",
    "Ambient",
    "OutdoorAmbient",
    "ColorShift_Top",
    "ColorShift_Bottom",
    "EnvironmentDiffuseScale",
    "EnvironmentSpecularScale",
    "ShadowSoftness",
    "FogColor",
    "FogStart",
    "FogEnd"
}) do
    saveProperty(Lighting, propertyName)
end

if Terrain then
    for _, propertyName in ipairs({
        "WaterColor",
        "WaterReflectance",
        "WaterTransparency",
        "WaterWaveSize",
        "WaterWaveSpeed"
    }) do
        saveProperty(Terrain, propertyName)
    end
end

-- 儲存原本的 Atmosphere、Sky、Bloom 等效果
for _, object in ipairs(Lighting:GetChildren()) do
    if object:IsA("Atmosphere")
        or object:IsA("BloomEffect")
        or object:IsA("ColorCorrectionEffect")
        or object:IsA("SunRaysEffect")
        or object:IsA("DepthOfFieldEffect")
        or object:IsA("Sky") then

        table.insert(savedEffects, object:Clone())
    end
end

--==================================================
-- 共用函式
--==================================================

local function createOwned(className, name, parent)
    local object = Instance.new(className)
    object.Name = PREFIX .. name
    object.Parent = parent or Lighting
    return object
end

local function clearOwnedEffects()
    for _, object in ipairs(Lighting:GetChildren()) do
        if object.Name:sub(1, #PREFIX) == PREFIX then
            object:Destroy()
        end
    end

    if Terrain then
        for _, object in ipairs(Terrain:GetChildren()) do
            if object.Name:sub(1, #PREFIX) == PREFIX then
                object:Destroy()
            end
        end
    end
end

local function setupBaseLighting()
    pcall(function()
        Lighting.Technology = Enum.Technology.Future
    end)

    Lighting.GlobalShadows = true
    Lighting.ShadowSoftness = 0.09
    Lighting.EnvironmentDiffuseScale = 0.86
    Lighting.EnvironmentSpecularScale = 0.94
end

local function setupWater()
    if not Terrain then
        return
    end

    pcall(function()
        Terrain.WaterColor = Color3.fromRGB(55, 164, 205)
        Terrain.WaterReflectance = 0.72
        Terrain.WaterTransparency = 0.2
        Terrain.WaterWaveSize = 0.7
        Terrain.WaterWaveSpeed = 20
    end)
end

local function setupCloud(color, cover, density)
    if not Terrain then
        return
    end

    local clouds = createOwned("Clouds", "Clouds", Terrain)
    clouds.Color = color
    clouds.Cover = cover
    clouds.Density = density
end

local function setupPostEffects(
    atmosphereColor,
    atmosphereDecay,
    atmosphereDensity,
    atmosphereHaze,
    tintColor,
    brightness,
    contrast,
    saturation,
    bloomIntensity,
    sunRaysIntensity
)
    local atmosphere = createOwned("Atmosphere", "Atmosphere")
    atmosphere.Color = atmosphereColor
    atmosphere.Decay = atmosphereDecay
    atmosphere.Density = atmosphereDensity
    atmosphere.Haze = atmosphereHaze
    atmosphere.Glare = 0.06
    atmosphere.Offset = 0.25

    local colorCorrection = createOwned("ColorCorrectionEffect", "Color")
    colorCorrection.TintColor = tintColor
    colorCorrection.Brightness = brightness
    colorCorrection.Contrast = contrast
    colorCorrection.Saturation = saturation

    local bloom = createOwned("BloomEffect", "Bloom")
    bloom.Intensity = bloomIntensity
    bloom.Size = 20
    bloom.Threshold = 1.15

    if sunRaysIntensity then
        local sunRays = createOwned("SunRaysEffect", "SunRays")
        sunRays.Intensity = sunRaysIntensity
        sunRays.Spread = 0.8
    end
end

