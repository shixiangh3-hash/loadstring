-- ==================== 邏輯處理 ====================
local draggingFov, draggingSmooth, draggingColor = false, false, false

local function updateFov(input)
    local width = math.max(fovTrack.AbsoluteSize.X, 1)
    local ratio = math.clamp((input.Position.X - fovTrack.AbsolutePosition.X) / width, 0, 1)
    fovKnob.Position = UDim2.new(ratio, -10, 0.5, -10)
    fovRadius = math.floor(50 + ratio * 350)
    fovLabel.Text = "FOV 大小：" .. fovRadius
    fovCircle.Size = UDim2.fromOffset(fovRadius * 2, fovRadius * 2)
end

local function updateSmooth(input)
    local width = math.max(smoothTrack.AbsoluteSize.X, 1)
    local ratio = math.clamp((input.Position.X - smoothTrack.AbsolutePosition.X) / width, 0, 1)
    smoothKnob.Position = UDim2.new(ratio, -10, 0.5, -10)
    smoothness = math.clamp(0.01 + ratio * 0.99, 0.01, 1.0)
    smoothLabel.Text = string.format("平滑度：%.2f", smoothness)
end

local function updateColor(input)
    local width = math.max(colorTrack.AbsoluteSize.X, 1)
    local ratio = math.clamp((input.Position.X - colorTrack.AbsolutePosition.X) / width, 0, 1)
    colorKnob.Position = UDim2.new(ratio, -10, 0.5, -10)
    currentColor = Color3.fromHSV(ratio, 1, 1)
    colorKnob.BackgroundColor3 = currentColor
    fovStroke.Color = currentColor
    ms.Color = currentColor
    ost.Color = currentColor
    lockStatusLabel.TextColor3 = currentColor
end

local function bindSlider(track, knob, updateFn, dragVarSetter)
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragVarSetter(true); updateFn(input)
        end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragVarSetter(true)
        end
    end)
end

bindSlider(fovTrack, fovKnob, updateFov, function(v) draggingFov = v end)
bindSlider(smoothTrack, smoothKnob, updateSmooth, function(v) draggingSmooth = v end)
bindSlider(colorTrack, colorKnob, updateColor, function(v) draggingColor = v end)

UIS.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if draggingFov then updateFov(input) end
        if draggingSmooth then updateSmooth(input) end
        if draggingColor then updateColor(input) end
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingFov = false; draggingSmooth = false; draggingColor = false
    end
end)

