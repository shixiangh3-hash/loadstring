    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingFloat = true
        floatDragStart = input.Position
        floatStartPos = floatAimBtn.Position
        floatMoved = false
    end
end)
UIS.InputChanged:Connect(function(input)
    if isDraggingFloat and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - floatDragStart
        if d.Magnitude > 10 then floatMoved = true end
        if floatMoved then
            floatAimBtn.Position = UDim2.new(floatStartPos.X.Scale, floatStartPos.X.Offset + d.X, floatStartPos.Y.Scale, floatStartPos.Y.Offset + d.Y)
        end
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if isDraggingFloat then
            isDraggingFloat = false
            if not floatMoved then
                isKeyAimbotActive = not isKeyAimbotActive
                if isKeyAimbotActive then
                    floatAimBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 70)
                    floatAimBtn.Text = "自瞄\n開啟"
                    fovCircle.Visible = true
                else
                    floatAimBtn.BackgroundColor3 = Color3.fromRGB(100, 40, 50)
                    floatAimBtn.Text = "自瞄\n關閉"
                    if not isAimbotEnabled then fovCircle.Visible = false end
                end
            end
        end
    end
end)

-- ==================== 核心 Aimbot / ESP / 連線 邏輯 ====================
local function isPlayerTeammate(targetPlayer)
    if not teamCheckEnabled then return false end
    if manualTeammates[targetPlayer] then return true end
    if targetPlayer.Team and LocalPlayer.Team and targetPlayer.Team == LocalPlayer.Team then return true end
    if targetPlayer.TeamColor and LocalPlayer.TeamColor and targetPlayer.TeamColor == LocalPlayer.TeamColor then
        if targetPlayer.TeamColor ~= Enum.BrickColor.White then return true end
    end
    return false
end

local hasDrawing = pcall(function() return Drawing.new("Line") end)

RunService.RenderStepped:Connect(function(dt)
    local camera = Workspace.CurrentCamera
    if not camera then return end

    -- 1. 更新 ESP (終極防重生版：掛在 GUI 上)
    if espEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            -- 確保角色存在、有血條、且不是隊友
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and not isPlayerTeammate(p) then
                local hl = espHighlights[p]
                if not hl or not hl.Parent then
                    hl = Instance.new("Highlight")
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = gui -- 放在 UI 層，角色死了也不會被吃掉
                    espHighlights[p] = hl
                end
                -- 每一幀強制綁定當前角色，重生也能瞬間恢復
                hl.Adornee = p.Character
                hl.FillColor = currentColor
                hl.OutlineColor = currentColor
            else
                if espHighlights[p] then
                    espHighlights[p]:Destroy()
                    espHighlights[p] = nil
                end
            end
        end
    else
        for _, hl in pairs(espHighlights) do if hl and hl.Parent then hl:Destroy() end end
        espHighlights = {}
    end

    -- 2. 更新距離連線 (Tracer)
    if tracerEnabled and hasDrawing then
        local activeTargets = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and not isPlayerTeammate(p) then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        activeTargets[p] = Vector2.new(pos.X, pos.Y)
                    end
                end
            end
        end

        for p, line in pairs(tracerLines) do
            if not activeTargets[p] then
                line:Remove()
                tracerLines[p] = nil
            end
        end

        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local fromPos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y - 50)
        if myHrp then
            local myPos, myOnScreen = camera:WorldToViewportPoint(myHrp.Position)
            if myOnScreen then
                fromPos = Vector2.new(myPos.X, myPos.Y + 50)
            end
        end

        for p, toPos in pairs(activeTargets) do
            local line = tracerLines[p]
            if not line then
                line = Drawing.new("Line")
                line.Thickness = 1.5
                line.Transparency = 0.8
                tracerLines[p] = line
            end
            line.Visible = true
            line.From = fromPos
            line.To = toPos
            line.Color = currentColor
        end
    else
        for p, line in pairs(tracerLines) do
            line:Remove()
            tracerLines[p] = nil
        end
    end

    -- 3. 核心 Aimbot 邏輯
    if not isAimbotEnabled and not isKeyAimbotActive then return end

    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local closestTarget = nil
    local minDistance = fovRadius

    local checkList = Players:GetPlayers()
    if lockedPlayer then
        checkList = {lockedPlayer}
    end

    for _, player in ipairs(checkList) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            
            if humanoid and humanoid.Health > 0 then
                local isTeammate = isPlayerTeammate(player)
                if lockedPlayer then isTeammate = false end

                if not isTeammate then
                    local targetPartObj = char:FindFirstChild(targetPart)
                    if not targetPartObj and targetPart == "LeftFoot" then
                        targetPartObj = char:FindFirstChild("Left Leg") or char:FindFirstChild("RightFoot")
                    end

                    if targetPartObj then
                        local screenPos, onScreen = camera:WorldToViewportPoint(targetPartObj.Position)
                        if onScreen then
                            local distance = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                            if distance < minDistance then
                                local canSee = true
                                if wallCheckEnabled then
                                    local rayParams = RaycastParams.new()
                                    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, char}
                                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                    local rayResult = Workspace:Raycast(camera.CFrame.Position, targetPartObj.Position - camera.CFrame.Position, rayParams)
                                    if rayResult then canSee = false end
                                end

                                if canSee then
                                    minDistance = distance
                                    closestTarget = targetPartObj
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if closestTarget then
        local targetCFrame = CFrame.lookAt(camera.CFrame.Position, closestTarget.Position)
        local alpha = math.clamp(smoothness * (dt * 60), 0, 1)
        camera.CFrame = camera.CFrame:Lerp(targetCFrame, alpha)
    end
end)

