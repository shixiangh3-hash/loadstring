-- 8. 關閉全圖反光與陰影
local function applyShadowToObj(obj)
    if not obj:IsA("BasePart") then return end
    if obj:IsDescendantOf(LocalPlayer.Character) then return end
    pcall(function() obj.Reflectance = 0; obj.CastShadow = false end)
end

local function toggleShadowReflect()
    isShadowOff = not isShadowOff
    if isShadowOff then
        shadowBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
        shadowBtn.Text = "💡 已關閉反光與陰影 (自動重套)"
        for _, obj in ipairs(Workspace:GetDescendants()) do applyShadowToObj(obj) end
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("ColorCorrectionEffect") or obj:IsA("BloomEffect") or obj:IsA("SunRaysEffect") then
                pcall(function() obj.Enabled = false end)
            end
        end
    else
        shadowBtn.BackgroundColor3 = Color3.fromRGB(100, 80, 60)
        shadowBtn.Text = "💡 關閉全圖反光與陰影"
    end
end

-- 9. 遠處剔除
local function applyCulling()
    isCullingEnabled = not isCullingEnabled
    if isCullingEnabled then
        cullingBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50); cullingBtn.Text = "👁️ 已開啟剔除"
        local tickRate = 0
        cullingConn = RunService.Heartbeat:Connect(function(dt)
            tickRate = tickRate + dt
            if tickRate < 0.5 then return end
            tickRate = 0
            local cam = Workspace.CurrentCamera; if not cam then return end
            for _, obj in ipairs(Workspace:GetChildren()) do
                if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                    if (obj.Position - cam.CFrame.Position).Magnitude > 500 then
                        if obj.LocalTransparencyModifier ~= 1 then obj.LocalTransparencyModifier = 1; hiddenParts[obj] = true end
                    else
                        if hiddenParts[obj] then obj.LocalTransparencyModifier = 0; hiddenParts[obj] = nil end
                    end
                end
            end
        end)
    else
        cullingBtn.BackgroundColor3 = Color3.fromRGB(50, 100, 130); cullingBtn.Text = "👁️ 遠處剔除 (隱藏500格)"
        if cullingConn then cullingConn:Disconnect(); cullingConn = nil end
        for obj, _ in pairs(hiddenParts) do pcall(function() obj.LocalTransparencyModifier = 0 end) end
        table.clear(hiddenParts)
    end
end

-- ==================== 【新增】地圖切換 / 新物件自動重套 ====================

-- 對單一新加入的物件重新套用所有已開啟效果
local function reapplyToNewObject(obj)
    if isTextureDeleted then applyColorToPart(obj) end
    if isParticleMuted then applyParticleToObj(obj) end
    if isShadowOff then applyShadowToObj(obj) end
end

-- 掃描整個 Workspace（地圖切換時呼叫）
local function reapplyAll()
    if reapplyDebounce then return end
    reapplyDebounce = true
    task.spawn(function()
        -- 等新地圖載入
        task.wait(2)
        if isTextureDeleted then
            for _, obj in ipairs(Workspace:GetDescendants()) do applyColorToPart(obj) end
        end
        if isParticleMuted then
            for _, obj in ipairs(Workspace:GetDescendants()) do applyParticleToObj(obj) end
        end
        if isShadowOff then
            for _, obj in ipairs(Workspace:GetDescendants()) do applyShadowToObj(obj) end
        end
        if isPlayerSimplified then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then simplifyPlayer(p.Character) end
            end
        end
        if isAnimDeleted then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then stopAnims(p.Character) end
            end
        end
        -- 重新套用 Lighting
        if isTextureDeleted then
            pcall(function()
                Lighting.GlobalShadows = false
                Lighting.EnvironmentDiffuseScale = 0
                Lighting.EnvironmentSpecularScale = 0
                Lighting.FogStart = 100000
                Lighting.FogEnd = 100000
                Lighting.ClockTime = 14
                Lighting.Ambient = targetColor
                Lighting.OutdoorAmbient = targetColor
            end)
            for _, obj in ipairs(Lighting:GetChildren()) do
                if obj:IsA("Sky") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then
                    pcall(function() obj:Destroy() end)
                end
            end
        end
        reapplyDebounce = false
    end)
end

-- 監聽新物件加入（例如傳送後地圖載入）
mapWatcherConn = Workspace.DescendantAdded:Connect(function(obj)
    -- 只對 BasePart / 粒子 有反應，避免效能爆炸
    if obj:IsA("BasePart") or obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Decal") or obj:IsA("Texture") then
        task.defer(function()
            if obj and obj.Parent then
                reapplyToNewObject(obj)
            end
        end)
    end
end)

-- 監聽 Workspace 頂層子物件變化（地圖切換通常會移除舊地圖 Folder、加入新 Folder）
Workspace.ChildAdded:Connect(function(child)
    if child:IsA("Folder") or child:IsA("Model") or child:IsA("Workspace") then
        -- 新地圖可能是資料夾/模型，延遲後整體重掃
        task.delay(1, reapplyAll)
    end
end)

-- 【重點】監聽角色 CFrame 大跳（傳送），或角色重生
local lastCharPos = Vector3.zero
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local pos = hrp.Position
    if lastCharPos == Vector3.zero then lastCharPos = pos; return end
    local dist = (pos - lastCharPos).Magnitude
    if dist > 300 then  -- 距離超過 300 視為傳送
        reapplyAll()
    end
    lastCharPos = pos
end)

