-- 【新增】單一物件套用純色（抽出來給地圖切換用）
local function applyColorToPart(obj)
    if not obj:IsA("BasePart") then return end
    if obj:IsDescendantOf(LocalPlayer.Character) then return end
    if obj:FindFirstAncestorOfClass("Tool") then return end
    pcall(function()
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("Decal") or child:IsA("Texture") or child:IsA("SurfaceAppearance") then child:Destroy() end
        end
        obj.Material = Enum.Material.SmoothPlastic
        obj.Reflectance = 0
        obj.CastShadow = false
        obj.Color = targetColor
    end)
end

-- 1. 全圖純色
local function applyTextureDelete()
    if isTextureDeleted then return end
    isTextureDeleted = true
    pcall(function()
        if not savedQuality then savedQuality = settings().Rendering.QualityLevel end
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    Lighting.GlobalShadows = false
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
    Lighting.FogStart = 100000
    Lighting.FogEnd = 100000
    Lighting.ClockTime = 14
    Lighting.Ambient = targetColor
    Lighting.OutdoorAmbient = targetColor
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Sky") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then
            pcall(function() obj:Destroy() end)
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        applyColorToPart(obj)
    end
    textureBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
    textureBtn.Text = "🗑️ 已統一純色 (自動重套)"
end

-- 2. 粒子抹除
local function applyParticleToObj(obj)
    if not (obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles")) then return end
    if obj:FindFirstAncestorOfClass("Tool") then return end
    pcall(function() obj.Enabled = false; obj.Texture = "" end)
end

local function applyParticleMute()
    isParticleMuted = not isParticleMuted
    if isParticleMuted then
        particleBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
        particleBtn.Text = "✨ 已抹除粒子 (自動重套)"
        for _, obj in ipairs(Workspace:GetDescendants()) do
            applyParticleToObj(obj)
        end
    else
        particleBtn.BackgroundColor3 = Color3.fromRGB(120, 80, 150)
        particleBtn.Text = "✨ 粒子徹底抹除"
    end
end

-- 3. 補幀
local function toggleSmooth()
    isSmoothEnabled = not isSmoothEnabled
    if isSmoothEnabled then
        smoothBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
        smoothBtn.Text = "✨ 已開啟補幀"
        local currentCF = Workspace.CurrentCamera.CFrame
        smoothConn = RunService.RenderStepped:Connect(function()
            local camera = Workspace.CurrentCamera
            if camera then
                currentCF = currentCF:Lerp(camera.CFrame, 0.15)
                camera.CFrame = currentCF
            end
        end)
    else
        smoothBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 150)
        smoothBtn.Text = "✨ 畫面平滑補幀"
        if smoothConn then smoothConn:Disconnect(); smoothConn = nil end
    end
end

-- 4. 顯示 FPS
local function toggleFPS()
    isFpsShowing = not isFpsShowing
    if isFpsShowing then
        fpsBtn.BackgroundColor3 = Color3.fromRGB(30, 150, 80)
        fpsBtn.Text = "📊 隱藏 FPS"
        fpsGui = Instance.new("ScreenGui"); fpsGui.Name = PREFIX.."Fps"; fpsGui.ResetOnSpawn = false; fpsGui.IgnoreGuiInset = true; fpsGui.Parent = PlayerGui
        fpsLabel = Instance.new("TextLabel"); fpsLabel.Size = UDim2.fromOffset(120, 35); fpsLabel.Position = UDim2.new(1, -130, 0, 15); fpsLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0); fpsLabel.BackgroundTransparency = 0.5; fpsLabel.Text = "FPS: --"; fpsLabel.TextColor3 = Color3.fromRGB(0, 255, 0); fpsLabel.Font = Enum.Font.Code; fpsLabel.TextSize = 18; fpsLabel.Parent = fpsGui
        local frames, time = 0, 0
        fpsConn = RunService.RenderStepped:Connect(function(dt)
            frames = frames + 1; time = time + dt
            if time >= 0.5 then
                local fps = math.floor(frames / time + 0.5)
                fpsLabel.Text = "FPS: " .. fps
                fpsLabel.TextColor3 = fps >= 50 and Color3.fromRGB(0,255,0) or (fps >= 30 and Color3.fromRGB(255,255,0) or Color3.fromRGB(255,50,50))
                frames, time = 0, 0
            end
        end)
    else
        fpsBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 80)
        fpsBtn.Text = "📊 顯示 FPS"
        if fpsConn then fpsConn:Disconnect(); fpsConn = nil end
        if fpsGui then fpsGui:Destroy(); fpsGui = nil end
    end
end

-- 5. 玩家純灰
local function simplifyPlayer(char)
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Clothing") or obj:IsA("Accessory") then pcall(function() obj:Destroy() end) end
        if obj:IsA("BasePart") then
            pcall(function()
                obj.Color = Color3.fromRGB(150, 150, 150); obj.Material = Enum.Material.SmoothPlastic
                for _, child in ipairs(obj:GetChildren()) do if child:IsA("Decal") or child:IsA("Texture") then child:Destroy() end end
            end)
        end
    end
end
local function applyPlayerSimplify()
    isPlayerSimplified = not isPlayerSimplified
    if isPlayerSimplified then
        playerBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50); playerBtn.Text = "👤 已純灰 (自動重套)"
        for _, p in ipairs(Players:GetPlayers()) do if p.Character then simplifyPlayer(p.Character) end end
    else
        playerBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100); playerBtn.Text = "👤 玩家優化 (純灰人)"
    end
end

-- 6. 刪除動畫
local function stopAnims(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator"); if not animator then return end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do pcall(function() track:Stop(0) end) end
    local animate = char:FindFirstChild("Animate"); if animate then pcall(function() animate:Destroy() end) end
    if animConnections[char] then animConnections[char]:Disconnect() end
    animConnections[char] = animator.AnimationPlayed:Connect(function(track) if isAnimDeleted then pcall(function() track:Stop(0) end) end end)
end
local function applyAnimationRemove()
    isAnimDeleted = not isAnimDeleted
    if isAnimDeleted then
        animBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50); animBtn.Text = "🏃 已刪除動畫"
        for _, p in ipairs(Players:GetPlayers()) do if p.Character then stopAnims(p.Character) end end
    else
        animBtn.BackgroundColor3 = Color3.fromRGB(70, 90, 120); animBtn.Text = "🏃 刪除動畫 (全員滑行)"
    end
end

