-- ==================== 自動監聽 ====================
local function onCharacterAdded(char)
    task.wait(1)
    if isPlayerSimplified then simplifyPlayer(char) end
    if isAnimDeleted then stopAnims(char) end
    -- 角色重生時也重套一次地圖（保險）
    task.delay(2, reapplyAll)
end
for _, p in ipairs(Players:GetPlayers()) do
    p.CharacterAdded:Connect(onCharacterAdded)
    if p.Character then task.spawn(function() if isPlayerSimplified then simplifyPlayer(p.Character) end; if isAnimDeleted then stopAnims(p.Character) end end) end
end
Players.PlayerAdded:Connect(function(p) p.CharacterAdded:Connect(onCharacterAdded) end)

-- 懸浮球拖曳與點擊
orb.Activated:Connect(function() main.Visible = not main.Visible end)
local orbDragging, orbMoved = false, false
local dragStart, orbStart
orb.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        orbDragging = true; orbMoved = false; dragStart = input.Position; orbStart = orb.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if orbDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        if d.Magnitude > 8 then orbMoved = true end
        orb.Position = UDim2.new(orbStart.X.Scale, orbStart.X.Offset + d.X, orbStart.Y.Scale, orbStart.Y.Offset + d.Y)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then orbDragging = false end
end)

