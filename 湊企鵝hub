local function notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 5,
        })
    end)
end

local function compileRemote(url)
    local okDownload, sourceOrError = pcall(function()
        return game:HttpGet(url, true)
    end)

    if not okDownload then
        return nil, "下載失敗：" .. tostring(sourceOrError)
    end

    if type(sourceOrError) ~= "string" or sourceOrError == "" then
        return nil, "下載內容為空白"
    end

    local okCompile, functionOrError = pcall(function()
        return loadstring(sourceOrError)
    end)

    if not okCompile or type(functionOrError) ~= "function" then
        return nil, "編譯失敗：" .. tostring(functionOrError)
    end

    return functionOrError
end

local function runRemote(url, name)
    task.spawn(function()
        local scriptFunction, errorMessage = compileRemote(url)
        if not scriptFunction then
            warn("湊企鵝Hub｜" .. name .. "：", errorMessage)
            notify("湊企鵝Hub", name .. " 載入失敗")
            return
        end

        local okRun, runError = pcall(function()
            scriptFunction()
        end)

        if not okRun then
            warn("湊企鵝Hub｜" .. name .. " 執行失敗：", runError)
            notify("湊企鵝Hub", name .. " 執行失敗")
        end
    end)
end

