local function addCorner(object, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 10)
    corner.Parent = object
end

local function addStroke(object)
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(235, 235, 255)
    stroke.Thickness = 1
    stroke.Transparency = 0.2
    stroke.Parent = object
end

local function findMainGui()
    return GuiParent:FindFirstChild("PenguinHubMainV15")
end

local function findPageByButton(texts)
    local mainGui = findMainGui()
    if not mainGui then
        return nil
    end

    for _, object in ipairs(mainGui:GetDescendants()) do
        if object:IsA("ScrollingFrame") then
            for _, child in ipairs(object:GetChildren()) do
                if child:IsA("TextButton") then
                    for _, text in ipairs(texts) do
                        if child.Text == text then
                            return object
                        end
                    end
                end
            end
        end
    end

    return nil
end

local function getButton(page, text)
    if not page then
        return nil
    end

    for _, child in ipairs(page:GetChildren()) do
        if child:IsA("TextButton") and child.Text == text then
            return child
        end
    end

    return nil
end

local function setButtonY(page, text, y)
    local button = getButton(page, text)
    if button then
        button.Position = UDim2.new(0, 20, 0, y)
        button.Size = UDim2.new(0, 280, 0, 35)
    end
end

local function createButtonIfMissing(page, name, text, y, callback)
    if not page or getButton(page, text) then
        return
    end

    local button = Instance.new("TextButton")
    button.Name = name
    button.Position = UDim2.new(0, 20, 0, y)
    button.Size = UDim2.new(0, 280, 0, 35)
    button.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    button.BackgroundTransparency = 0.25
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Text = text
    button.Font = Enum.Font.SourceSansBold
    button.TextSize = 14
    button.TextWrapped = true
    button.Parent = page
    addCorner(button, 10)
    addStroke(button)
    button.MouseButton1Click:Connect(callback)
end

