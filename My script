local function removeHubTools()
    local names = {
        ["趣味寶劍"] = true,
        ["速度彈簧"] = true,
        ["重力彈簧"] = true,
    }
    for _, container in ipairs({LocalPlayer.Backpack, getCharacter()}) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if names[item.Name] then
                    item:Destroy()
                end
            end
        end
    end
end

local function resetHubSettings()
    godMode = false
    noclip = false
    infJump = false
    antiAfk = false
    fullBright = false
    rainbowChar = false
    restoreCharacterColors()
    restoreCollisions()
    clearRainbowTrail()
    clearFireTrail()
    clearCheckpoint()
    checkpointBall.Visible = false

    local humanoid = getHumanoid()
    if humanoid then
        humanoid.WalkSpeed = DEFAULT_WALK_SPEED
        humanoid.UseJumpPower = true
        humanoid.JumpPower = DEFAULT_JUMP_POWER
    end

    local root = getRoot()
    if root then
        root.Anchored = false
        safeDestroy(root:FindFirstChild("PenguinGravityCoilForce"))
    end

    stopFreeCam()
    safeDestroy(freeCamGuiObj)
    freeCamGuiObj = nil
    safeDestroy(dashGuiObj)
    dashGuiObj = nil
    fovActive = false
    LocalPlayer.CameraMode = originalCameraMode
    getCamera().CameraType = Enum.CameraType.Custom
    getCamera().FieldOfView = originalFieldOfView
    if fovControlFrame then
        fovControlFrame.Visible = false
    end
    fovButton.Text = "開啟／關閉視覺 FOV（第一人稱）"

    restoreLighting()
    restoreOriginalSky()
    espEnabled = false
    refreshESP()
    removeHubTools()
    table.clear(activeFeatures)
    systemInfo.Text = "已重置：速度、跳躍、視角、FOV、天空、存檔點、軌跡、Dash、ESP、全亮、穿牆、無限跳與 Hub 道具均已關閉。"
end

