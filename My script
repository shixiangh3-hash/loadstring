    rainbowChar = not rainbowChar
    setFeature("彩虹人", rainbowChar)
    if not rainbowChar then
        restoreCharacterColors()
        return
    end
    task.spawn(function()
        while rainbowChar do
            local character = getCharacter()
            if character then
                local color = Color3.fromHSV((tick() % 5) / 5, 1, 1)
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        if originalPartColors[part] == nil then
                            originalPartColors[part] = part.Color
                        end
                        part.Color = color
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end)

