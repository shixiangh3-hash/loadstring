end

makeButton(pageVisual, 235, "開啟／關閉自由視角工具（右側相機）", function()
    if freeCamGuiObj then
        stopFreeCam()
        safeDestroy(freeCamGuiObj)
        freeCamGuiObj = nil
        return
    end

    local gui = createScreenGui("PenguinFreeCamGuiV15")
    freeCamGuiObj = gui
    local cameraButton = Instance.new("TextButton")
    cameraButton.Size = UDim2.new(0, 65, 0, 65)
    cameraButton.Position = UDim2.new(1, -85, 0.4, 0)
    cameraButton.BackgroundColor3 = Color3.fromRGB(255, 110, 0)
    cameraButton.BackgroundTransparency = 0.2
    cameraButton.Text = "📷"
    cameraButton.TextSize = 30
    cameraButton.Parent = gui
    addCorner(cameraButton, 99)
    addStroke(cameraButton, Color3.new(1, 1, 1), 1)
    local cameraMoved = makeSmartDraggable(cameraButton)

    cameraButton.MouseButton1Click:Connect(function()
        if cameraMoved() then
            return
        end
        if freeCamActive then
            stopFreeCam()
            cameraButton.BackgroundColor3 = Color3.fromRGB(255, 110, 0)
            return
        end

        if fovActive then
            fovActive = false
            LocalPlayer.CameraMode = originalCameraMode
            getCamera().FieldOfView = originalFieldOfView
            if fovControlFrame then
                fovControlFrame.Visible = false
            end
            setFeature("FOV", false)
        end

        local character = getCharacter()
        local root = getRoot()
        local camera = getCamera()
        if not character or not root then
            return
        end

        freeCamActive = true
        setFeature("自由視角", true)
        cameraButton.BackgroundColor3 = Color3.fromRGB(0, 215, 100)
        freeCamRootWasAnchored = root.Anchored
        root.Anchored = true
        camera.CameraType = Enum.CameraType.Scriptable

        local startCFrame = camera.CFrame
        local head = character:FindFirstChild("Head")
        if head then
            startCFrame = CFrame.new(head.Position + Vector3.new(0, 0.45, 0)) * (camera.CFrame - camera.CFrame.Position)
        end
        local cameraPosition = startCFrame.Position
        local pitch, yaw = startCFrame:ToOrientation()

        freeCamInputConn = UserInputService.InputChanged:Connect(function(input)
            if not freeCamActive then
                return
            end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                pitch = math.clamp(pitch - input.Delta.Y * 0.003, -1.5, 1.5)
                yaw = yaw - input.Delta.X * 0.003
            end
        end)

        freeCamRenderConn = RunService.RenderStepped:Connect(function(dt)
            local humanoid = getHumanoid()
            local speed = humanoid and humanoid.WalkSpeed or DEFAULT_WALK_SPEED
            local direction = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + Vector3.new(0, 0, -1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction + Vector3.new(0, 0, 1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction + Vector3.new(-1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + Vector3.new(1, 0, 0) end

            pcall(function()
                local controls = require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
                local mobileDirection = controls:GetMoveVector()
                direction = direction + Vector3.new(mobileDirection.X, 0, mobileDirection.Z)
            end)

            local rotation = CFrame.fromOrientation(pitch, yaw, 0)
            if direction.Magnitude > 0 then
                cameraPosition = cameraPosition + rotation:VectorToWorldSpace(direction.Unit) * speed * 1.5 * dt
            end
            camera.CFrame = CFrame.new(cameraPosition) * rotation
        end)
    end)
end)

