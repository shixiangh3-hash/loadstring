local function runExternalScript(url)
    task.spawn(function()
        local ok, err = pcall(function()
            local source = game:HttpGet(url)
            local scriptFunction = loadstring(source)
            if type(scriptFunction) ~= "function" then
                error("loadstring 無法編譯外部腳本")
            end
            scriptFunction()
        end)
        if not ok then
            warn("湊企鵝Hub：外部功能載入失敗：", err)
        end
    end)
end

-- 無敵專用載入器：下載、編譯、執行分開處理，錯誤會顯示在輸出。
local function runInvincibleScript()
    local url = "https://raw.githubusercontent.com/mascaracathub/Test-Script/refs/heads/main/obfuscated_script-1765900058766.lua.txt"

    local downloaded, sourceOrError = pcall(function()
        return game:HttpGet(url)
    end)
    if not downloaded or type(sourceOrError) ~= "string" or sourceOrError == "" then
        warn("湊企鵝Hub：無敵腳本下載失敗：", sourceOrError)
        return
    end

    local compiled, functionOrError = pcall(function()
        return loadstring(sourceOrError)
    end)
    if not compiled or type(functionOrError) ~= "function" then
        warn("湊企鵝Hub：無敵腳本編譯失敗：", functionOrError)
        return
    end

    local executed, executionError = pcall(function()
        return functionOrError()
    end)
    if not executed then
        warn("湊企鵝Hub：無敵腳本執行失敗：", executionError)
    end
end

local function createScreenGui(name)
    local old = GuiParent:FindFirstChild(name)
    if old then
        old:Destroy()
    end
    local gui = Instance.new("ScreenGui")
    gui.Name = name
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.Parent = GuiParent
    return gui
end

local function addCorner(object, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 10)
    corner.Parent = object
    return corner
end

local function addStroke(object, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Color3.new(1, 1, 1)
    stroke.Thickness = thickness or 1
    stroke.Transparency = 0.2
    stroke.Parent = object
    return stroke
end

-- 所有懸浮球統一防誤觸：
-- 必須從該物件開始、同一根手指／同一次滑鼠按壓，並移動超過 32 像素才拖動。
local function makeSmartDraggable(object, threshold)
    threshold = threshold or 32
    local activeTouch = nil
    local mousePressed = false
    local dragStart = nil
    local startPosition = nil
    local didMove = false
    object.Active = true

    object.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            activeTouch = input
            mousePressed = false
            dragStart = input.Position
            startPosition = object.Position
            didMove = false
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            activeTouch = nil
            mousePressed = true
            dragStart = input.Position
            startPosition = object.Position
            didMove = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        local ownerTouch = activeTouch ~= nil
            and input == activeTouch
            and input.UserInputType == Enum.UserInputType.Touch
        local ownerMouse = mousePressed
            and input.UserInputType == Enum.UserInputType.MouseMovement

        if not ownerTouch and not ownerMouse then
            return
        end
        if not dragStart or not startPosition then
            return
        end

        local delta = input.Position - dragStart
        if delta.Magnitude >= threshold then
            didMove = true
            object.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            mousePressed = false
        elseif activeTouch ~= nil and input == activeTouch then
            activeTouch = nil
        end
    end)

    return function()
        local moved = didMove
        didMove = false
        return moved
    end
end

local function makeButton(parent, y, text, callback)
    local button = Instance.new("TextButton")
    button.Position = UDim2.new(0, 20, 0, y)
    button.Size = UDim2.new(0, 280, 0, 35)
    button.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    button.BackgroundTransparency = 0.25
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Text = text
    button.Font = Enum.Font.SourceSansBold
    button.TextSize = 14
    button.TextWrapped = true
    button.Parent = parent
    addCorner(button, 10)
    button.MouseButton1Click:Connect(callback)
    return button
end

local function makeTextBox(parent, y, placeholder, callback)
    local box = Instance.new("TextBox")
    box.Position = UDim2.new(0, 20, 0, y)
    box.Size = UDim2.new(0, 280, 0, 30)
    box.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    box.BackgroundTransparency = 0.35
    box.PlaceholderText = placeholder
    box.PlaceholderColor3 = Color3.fromRGB(180, 180, 180)
    box.Text = ""
    box.TextColor3 = Color3.new(1, 1, 1)
    box.Font = Enum.Font.SourceSans
    box.TextSize = 14
    box.ClearTextOnFocus = false
    box.Parent = parent
    addCorner(box, 8)
    box.FocusLost:Connect(function()
        callback(box.Text)
    end)
    return box
end

